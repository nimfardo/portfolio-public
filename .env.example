# Unlocks the NDA-gated project pages. Build-time only — no PUBLIC_ prefix,
# so this never reaches the browser. The build encrypts each gated case
# study with a key derived from it (src/widgets/password-gate/lib/encrypt.ts)
# and ships only ciphertext; the password is the sole way to read it.
#
# Set the password itself here, not a hash of it. This replaced
# PUBLIC_NDA_PASSWORD_HASH in bug-073 — that gate compared a hash in the
# client bundle while the content it "protected" sat in the HTML the whole
# time behind display:none, which meant Google had the case studies indexed
# with the client names in them.
#
# Optional in this public mirror, which ships no gated projects.
NDA_PASSWORD=

# Powers the live /projects/gallery page (src/entities/photo/api/unsplash.ts)
# — client-side fetch of your public Unsplash photos, no backend involved.
# Get an Access Key at unsplash.com/oauth/applications ("New Application").
# Demo apps are capped at 50 requests/hour, shared across all visitors.
PUBLIC_UNSPLASH_ACCESS_KEY=
