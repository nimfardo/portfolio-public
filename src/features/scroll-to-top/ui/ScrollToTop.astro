---
// Figma (node 2377:2011) shows this as a 60x60 icon button anchored to
// one page's content corner; implemented as global chrome instead (mounted
// once in Layout.astro, matching Navigation/Preloader) since a "scroll to
// top" control is conventionally a viewport-fixed FAB that appears once
// the user has actually scrolled, not something tied to one page's layout.
import { Icon } from '@shared/ui';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['scroll-to-top', className]}
  data-scroll-to-top
  aria-label="Scroll to top"
  transition:persist
>
  {
    /* Ring's stroke-dashoffset is driven by --scroll-progress (set in the
     * script below), inherited from the button. pathLength="100" normalizes
     * the rect's actual perimeter to 100 units, so dasharray/dashoffset are
     * plain 0-100 percentages regardless of the button's real pixel size. */
  }
  <svg class="scroll-to-top__ring" width="60" height="60" viewBox="0 0 60 60" aria-hidden="true">
    <rect
      x="0.5"
      y="0.5"
      width="59"
      height="59"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      pathLength="100"
    />
  </svg>
  <Icon name="arrow-up" size={28} />
</button>

<script>
  import { bindOncePersisted, prefersReducedMotion } from '@shared/lib';

  // Recomputes maxScroll fresh every call (not cached) so it stays correct
  // across resizes and content reflow without a separate resize listener.
  function syncScrollToTop(button: HTMLButtonElement) {
    const scrollY = window.scrollY;
    button.classList.toggle('is-visible', scrollY > window.innerHeight);

    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? Math.min(Math.max(scrollY / maxScroll, 0), 1) : 0;
    button.style.setProperty('--scroll-progress', progress.toFixed(4));
  }

  // Persists across ClientRouter swaps (transition:persist), so the button is
  // the same DOM node on every page. bindOncePersisted stops the scroll/click
  // listeners from stacking on repeat astro:page-load — but visibility and
  // scroll progress are page-specific and must be re-synced on EVERY load
  // regardless of binding, or a persisted node would keep showing the
  // previous page's progress until the reader's next scroll event.
  function initScrollToTop() {
    const button = document.querySelector<HTMLButtonElement>('[data-scroll-to-top]');
    if (!button) return;
    syncScrollToTop(button);

    bindOncePersisted<HTMLButtonElement>('[data-scroll-to-top]', (el) => {
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            syncScrollToTop(el);
            ticking = false;
          });
        },
        { passive: true },
      );

      el.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
      });
    });
  }

  document.addEventListener('astro:page-load', initScrollToTop);
</script>

<style>
  .scroll-to-top {
    position: fixed;
    right: var(--spacing-2xl);
    bottom: var(--spacing-2xl);
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: none;
    /* Same frosted treatment as the PageHeader / mobile nav header — see
       PageHeader.astro for why the tint is color-mixed off the theme token
       rather than pinned as a second palette. Those two animate from a
       transparent tint into this one because they exist at rest; this button
       does not appear until the reader is a full viewport down, so it is only
       ever seen in the scrolled state and takes those values flat. The blur
       stays inside the 60x60 border box, which is the same box the progress
       ring's rect traces, so the two edges line up. */
    background: color-mix(in srgb, var(--color-bg-default) 72%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    color: var(--color-text-accent);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity var(--duration-base) var(--ease-fade),
      transform var(--duration-base) var(--ease-fade),
      color var(--duration-base) var(--ease-fade);
  }
  .scroll-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .scroll-to-top:hover {
    color: var(--color-text-emphasis);
  }

  /* Replaces the old constant 1px border: the rect's stroke-dashoffset
     tracks --scroll-progress (0-1, set in the script above), so the stroke
     draws in clockwise from the top-left corner as the page scrolls rather
     than sitting fully drawn at a constant weight. */
  .scroll-to-top__ring {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--color-border-accent);
    transition: color var(--duration-base) var(--ease-fade);
  }
  .scroll-to-top__ring rect {
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - (var(--scroll-progress, 0) * 100));
  }
  .scroll-to-top:hover .scroll-to-top__ring {
    color: var(--color-border-emphasis);
  }

  @media (max-width: 767px) {
    .scroll-to-top {
      right: var(--spacing-lg);
      bottom: var(--spacing-lg);
    }
  }
</style>
