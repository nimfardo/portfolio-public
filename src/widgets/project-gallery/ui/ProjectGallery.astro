---
// Project detail-page gallery — a sequence of rows, each a full-width slot,
// a tall slot + N stacked slots, or a pair of equal-height slots side by
// side (the three shapes that exist on the Figma canvas so far, see
// entities/project's GalleryRow — `pair` exists because forcing a lone
// 468-tall slot into the `tall` shape's 1000-ratio box, as `split` would,
// stretches it and leaves dead space next to it; see that type's doc
// comment). Every slot carries real alt text — the empty `imageAlt: ''`
// these all used to pass was a WCAG 1.1.1 failure, not the decorative-image
// exemption it was written as. See the GalleryRow doc comment.
//
// Note that an empty alt still serialises here as a bare `alt` attribute
// rather than `alt=""`. Those are equivalent in HTML, so a genuinely
// decorative slot is still announced correctly.
//
// Every slot is a ProjectMedia now (feat-041), so any of them can be a
// video — Arvus's tall slot is one. Image slots render a bare <img>, exactly
// as before; video slots need a wrapper div because Media's Props are
// explicit with no attribute pass-through, so `data-reveal` cannot land on
// its root. That wrapper carries the sizing class and Media's own root is
// stretched to fill it, the same arrangement VideoSection uses.
//
// A slot can also be a Lottie (Motion's AdQuanto/underground/loadium) — same
// wrapper-div shape as video, plus an inline `background` style since the
// animation layers themselves are transparent (see GalleryMedia).
//
// All three branches are written inline rather than extracted to a shared
// slot component on purpose: an <img> rendered from a child component would
// carry that child's astro-cid, and this file's scoped `.project-gallery__*`
// rules would stop matching it.
import { Media } from '@entities/media';
import { staggerDelay } from '@shared/lib';
import type { GalleryRow } from '../model/types';

interface Props {
  rows: GalleryRow[];
  class?: string;
}

const { rows, class: className } = Astro.props;
---

<div class:list={['project-gallery', className]}>
  {
    rows.map((row) =>
      row.type === 'full' ? (
        row.image.type === 'image' ? (
          <img
            class="project-gallery__full"
            src={row.image.image}
            alt={row.image.imageAlt}
            loading="lazy"
            data-reveal
            data-media-skeleton
          />
        ) : row.image.type === 'video' ? (
          <div class="project-gallery__full" data-reveal>
            <Media
              type="video"
              class="project-gallery__media"
              src={row.image.src}
              poster={row.image.poster}
              alt={row.image.alt}
            />
          </div>
        ) : (
          <div
            class="project-gallery__full"
            data-reveal
            style={`background: ${row.image.background}`}
          >
            <Media
              type="lottie"
              class="project-gallery__media"
              src={row.image.src}
              alt={row.image.alt}
            />
          </div>
        )
      ) : row.type === 'pair' ? (
        <div class="project-gallery__row">
          {[row.left, row.right].map((slot) =>
            slot.type === 'image' ? (
              <img
                class="project-gallery__pair-item"
                src={slot.image}
                alt={slot.imageAlt}
                loading="lazy"
                data-reveal
                data-media-skeleton
              />
            ) : slot.type === 'video' ? (
              <div class="project-gallery__pair-item" data-reveal>
                <Media
                  type="video"
                  class="project-gallery__media"
                  src={slot.src}
                  poster={slot.poster}
                  alt={slot.alt}
                />
              </div>
            ) : (
              <div
                class="project-gallery__pair-item"
                data-reveal
                style={`background: ${slot.background}`}
              >
                <Media type="lottie" class="project-gallery__media" src={slot.src} alt={slot.alt} />
              </div>
            ),
          )}
        </div>
      ) : (
        <div class="project-gallery__row">
          {row.tall.type === 'image' ? (
            <img
              class="project-gallery__tall"
              src={row.tall.image}
              alt={row.tall.imageAlt}
              loading="lazy"
              data-reveal
              data-media-skeleton
            />
          ) : row.tall.type === 'video' ? (
            <div class="project-gallery__tall" data-reveal>
              <Media
                type="video"
                class="project-gallery__media"
                src={row.tall.src}
                poster={row.tall.poster}
                alt={row.tall.alt}
              />
            </div>
          ) : (
            <div
              class="project-gallery__tall"
              data-reveal
              style={`background: ${row.tall.background}`}
            >
              <Media
                type="lottie"
                class="project-gallery__media"
                src={row.tall.src}
                alt={row.tall.alt}
              />
            </div>
          )}
          <div class="project-gallery__stack">
            {row.stack.map((slot, i) =>
              slot.type === 'image' ? (
                <img
                  src={slot.image}
                  alt={slot.imageAlt}
                  loading="lazy"
                  data-reveal
                  data-media-skeleton
                  style={`--reveal-delay: ${staggerDelay(i, 100)}`}
                />
              ) : slot.type === 'video' ? (
                <div data-reveal style={`--reveal-delay: ${staggerDelay(i, 100)}`}>
                  <Media
                    type="video"
                    class="project-gallery__media"
                    src={slot.src}
                    poster={slot.poster}
                    alt={slot.alt}
                  />
                </div>
              ) : (
                <div
                  data-reveal
                  style={`--reveal-delay: ${staggerDelay(i, 100)}; background: ${slot.background}`}
                >
                  <Media
                    type="lottie"
                    class="project-gallery__media"
                    src={slot.src}
                    alt={slot.alt}
                  />
                </div>
              ),
            )}
          </div>
        </div>
      ),
    )
  }
</div>

<style>
  .project-gallery {
    display: flex;
    flex-direction: column;
    /* 64px — Frame 13's own internal rhythm between rows, distinct from
       the page's 160px section gap. */
    gap: 64px;
  }
  .project-gallery__full {
    position: relative;
    width: 100%;
    aspect-ratio: 1647 / 1000;
    object-fit: cover;
  }
  .project-gallery__row {
    display: flex;
    gap: 64px;
  }
  .project-gallery__tall {
    position: relative;
    flex: 1;
    min-width: 0;
    aspect-ratio: 791.5 / 1000;
    object-fit: cover;
  }
  .project-gallery__stack {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  /* `pair` row: two equal 468-tall boxes side by side (Motion's car+loadium
     row, node 3083:5522) — same per-slot ratio as a stack item, just not
     stacked. Shares `.project-gallery__row`'s flex+gap for the outer box. */
  .project-gallery__pair-item {
    position: relative;
    flex: 1;
    min-width: 0;
    aspect-ratio: 791.5 / 468;
    object-fit: cover;
  }
  /* `> *` rather than `> img`, so a video slot's wrapper div gets the same
     box. object-fit is inert on the div and does the work on the <img>;
     Media supplies its own object-fit: cover for the <video>.
     `position: relative` matters here specifically: these boxes are the
     MAIN axis of a column flex container (.project-gallery__stack), and a
     percentage height on a normal-flow child doesn't reliably resolve
     against a flex item sized only by `aspect-ratio` on that axis (it's a
     real spec/engine quirk, not just a Chrome bug — the "definite size for
     percentage children" guarantee flexbox gives a stretched CROSS-axis
     item doesn't extend to the MAIN axis). That let Motion's stacked Lottie
     slots ignore their 468px aspect ratio and stretch to evenly split
     whatever height was left over, dragging the whole row (and the tall
     video beside it) taller than intended. Anchoring `.project-gallery__media`
     with `position: absolute; inset: 0` below sidesteps the percentage
     entirely — the immediate `.project-gallery__tall` sibling wasn't
     affected only because it sits in the ROW's cross axis, which flexbox
     does mark definite once stretched. */
  .project-gallery__stack > * {
    position: relative;
    width: 100%;
    aspect-ratio: 791.5 / 468;
    object-fit: cover;
  }
  /* :global() — the class merges onto Media's own rendered root <div>, not a
     descendant of this component (the classlist-merge pattern every Icon and
     VideoSection consumer hits). `inset: 0` on an absolutely-positioned box
     fills its positioned ancestor's used size directly, unlike a percentage
     height/width which can fail to resolve there (see the comment on
     `.project-gallery__stack > *`). */
  :global(.project-gallery__media) {
    position: absolute;
    inset: 0;
  }

  @media (max-width: 1023px) {
    /* Matches .project-page__sections' own rhythm scaling at this
       breakpoint — same visual weight reduction applies to the gap
       between gallery rows as to the gap between page sections. */
    .project-gallery {
      gap: var(--spacing-4xl);
    }
  }
  @media (max-width: 767px) {
    .project-gallery {
      gap: var(--spacing-3xl);
    }
    .project-gallery__row {
      flex-direction: column;
      gap: var(--spacing-3xl);
    }
    .project-gallery__tall {
      aspect-ratio: 1647 / 1000;
    }
    .project-gallery__stack {
      gap: var(--spacing-3xl);
    }
  }
</style>
