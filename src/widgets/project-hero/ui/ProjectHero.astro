---
import { Divider, Icon } from '@shared/ui';
import { Media } from '@entities/media';
import type { HeroMedia } from '@entities/project';

// The top hero is now just a bare full-bleed image or video + a "Scroll
// down" cue (Figma dropped the tags/eyebrow/headline card from it — tags
// moved to widgets/overview-section, see connectis.ts). The eyebrow/headline
// card below is still used by the mid-page Challenge interstitial, but only
// until that section is migrated onto ContentSection's generalized
// `blocks` prop (see STATE.md) — this component will lose the card
// entirely once that lands, leaving just the bare-media+scroll-cue shape.
interface Props {
  /** Image, video, or a looping animation on a solid brand background —
   * see HeroMedia for why the lottie arm is hero-only.
   *
   * Optional because /process ships its hero before the video exists and
   * renders the placeholder box Figma shows (node 2712:2272). Deliberately
   * an absent prop rather than a fourth HeroMedia arm: ProjectContent.hero
   * is typed HeroMedia, so a placeholder arm would let a real case study
   * ship a blank hero. [slug].astro still passes content.hero, which stays
   * required — those pages can't lose their media silently. */
  media?: HeroMedia;
  eyebrow?: string;
  headline?: string[];
  scrollCue?: boolean;
  class?: string;
}

const { media, eyebrow, headline, scrollCue, class: className } = Astro.props;
const hasCard = Boolean(eyebrow && headline);
---

<section class:list={['project-hero', className]}>
  <div
    class:list={[
      'project-hero__image-wrap',
      {
        'project-hero__image-wrap--card': hasCard,
        'project-hero__image-wrap--placeholder': !media,
      },
    ]}
  >
    {
      media?.type === 'image' && (
        <img
          class="project-hero__image"
          src={media.image}
          alt={media.imageAlt}
          data-media-skeleton
        />
      )
    }
    {
      media?.type === 'video' && (
        <Media
          type="video"
          src={media.src}
          poster={media.poster}
          alt={media.alt}
          class="project-hero__image"
        />
      )
    }
    {
      media?.type === 'lottie' && (
        <div
          class="project-hero__stage"
          style={`background: ${media.background}; --hero-lottie-width: ${media.widthPct}%;`}
        >
          <Media
            type="lottie"
            src={media.src}
            alt={media.alt}
            lottieMode="pingpong-hold"
            lottieFallback={media.fallback}
            class="project-hero__lottie"
          />
        </div>
      )
    }
  </div>
  {
    scrollCue && (
      <div class="project-hero__scroll-cue">
        <p class="project-hero__scroll-text">Scroll down</p>
        <Icon name="scroll" size={28} class="project-hero__scroll-icon" />
      </div>
    )
  }
  {
    hasCard && (
      <div class="project-hero__card">
        <p class="project-hero__eyebrow">{eyebrow}</p>
        <Divider class="project-hero__divider" />
        <p class="project-hero__headline">
          {headline!.map((line) => <span>{line}</span>)}
        </p>
      </div>
    )
  }
</section>

<style>
  .project-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Figma's Hero-section is the exact same 1647px-wide column as every
       other section on the page (same width/x-offset as Project Overview,
       Process, etc.) — not full-bleed. Matches .project-page__sections'
       horizontal padding schedule exactly (bug-012, 2026-07-28). */
    padding: 0 40px;
  }

  .project-hero__image-wrap {
    position: relative;
    width: 100%;
    /* Bare variant shows the whole image: hero masters are exported
       1647×800 from Figma, and the content column is narrower than 1647px
       at laptop widths, so a fixed 800px height + cover was cropping the
       mockup horizontally. aspect-ratio reserves the box before the image
       loads (no CLS); the fixed-height cover-crop lives on the card
       variant only, where the portrait challenge image behind the card
       makes cropping intentional. */
    aspect-ratio: 1647 / 800;
  }
  /* Only the card variant needs the image pulled up underneath it — the
     bare scroll-cue variant sits in normal flow below the image instead. */
  .project-hero__image-wrap--card {
    aspect-ratio: auto;
    height: 800px;
    margin-bottom: -230px;
  }
  /* No media yet (/process, node 2712:2272): on canvas that hero holds an
     unset project-hero-image instance, which renders as a flat
     --color-bg-muted rectangle. The wrap's own aspect-ratio already reserves
     the 1647x800 box, so the placeholder is a fill and nothing else — no
     extra element, and passing a real `media` retires it with no other
     change. */
  .project-hero__image-wrap--placeholder {
    background: var(--color-bg-muted);
  }
  /* :global() — the class lands on a plain <img> in the image branch, but
     on Media's own rendered root <div> in the video branch (classlist-merge,
     not a descendant), which a scoped selector wouldn't reach. object-fit is
     inert on Media's wrapper div itself, but Media's internal CSS already
     applies object-fit:cover to its <video>, so both branches fill the
     aspect-ratio box the same way. Same pattern as ProcessAccordion's
     .process-step__image. */
  :global(.project-hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Lottie hero (medicalSoftware): a solid brand color with the logo animation
     centred on it. On canvas this hero was already a solid #263D82 fill plus
     a vector logo — not a raster image — so this renders what Figma always
     described, instead of flattening it to an exported still. The background
     comes in as an inline style because it's a fixed per-project brand
     value, not a token. */
  .project-hero__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  /* :global() — the class merges onto Media's own rendered root <div>, which
     is a classlist merge rather than a descendant, so a scoped selector
     would never match it (same reason .project-hero__image needs it).
     Width carries Figma's own logo-to-hero ratio so it scales with the fluid
     hero; the aspect-ratio is the Lottie's native 320x94, which derives the
     height without distorting the artwork. */
  :global(.project-hero__lottie) {
    width: var(--hero-lottie-width, 27.3%);
    aspect-ratio: 320 / 94;
    height: auto;
  }

  .project-hero__scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    color: var(--color-icon-default);
  }
  .project-hero__scroll-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    color: var(--color-text-primary);
  }
  /* :global() required — class merges onto Icon's own rendered <span>
     (same classlist-merge gotcha as every other Icon consumer). Animates
     `transform` only so the text/image above never reflow. */
  @keyframes project-hero-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(14px);
    }
  }
  :global(.project-hero__scroll-icon) {
    animation: project-hero-scroll-bounce 3s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.project-hero__scroll-icon) {
      animation: none;
    }
  }
  /* Dropped entirely on mobile, per Max's call (Figma node 2793:3170) —
     previously only the icon hid here and the "Scroll down" text stayed,
     but the cue reads as unnecessary chrome on a touch device either way. */
  @media (max-width: 767px) {
    .project-hero__scroll-cue {
      display: none;
    }
  }

  .project-hero__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    width: 100%;
    max-width: 1487px;
    padding: 80px;
    background: var(--color-bg-subtle);
  }
  .project-hero__eyebrow {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    color: var(--color-text-emphasis);
  }
  .project-hero__card :global(.divider) {
    width: 480px;
  }
  .project-hero__headline {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-bottom: 40px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-5xl);
    line-height: var(--font-line-height-5xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
  }

  @media (max-width: 767px) {
    .project-hero {
      /* Matches .project-page__sections' own 24px mobile horizontal padding. */
      padding: 0 24px;
    }
    .project-hero__image-wrap--card {
      height: 400px;
      margin-bottom: -120px;
    }
    .project-hero__card {
      padding: var(--spacing-xl);
    }
    .project-hero__headline {
      font-size: var(--font-size-3xl);
      line-height: var(--font-line-height-3xl);
    }
    .project-hero__card :global(.divider) {
      width: 240px;
    }
  }
</style>
