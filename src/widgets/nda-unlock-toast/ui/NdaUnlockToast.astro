---
// Marks the moment the NDA gate comes off, once per unlock.
//
// Before this, unlocking was silent: `tryUnlockNda` stored the key, and on the
// next visit to the grid ProjectGrid's `syncNdaMasks()` quietly stripped the
// confidential plates. The reader got the access with no acknowledgement that
// anything had changed site-wide.
//
// The trigger is a consume-on-read flag, not the unlock state itself — see
// `consumeNdaUnlockToast` in shared/lib/password-gate.ts for why those have to
// be two different signals. This widget is rendered by the page, not by
// ProjectGrid, so the grid's other consumer (/system's ComponentGallery) never
// fires it.
//
// THE MARK. A real Lottie, authored by us rather than downloaded —
// `scripts/build-lock-lottie.mjs` generates both theme colourways from
// locker.svg's own geometry. Two reasons, and the licence one is the hard one:
// every free Lottie source is blocked for this repo (UseAnimations is CC-BY
// and forbids redistribution, Lordicon's free tier demands a visible credit,
// LottieFiles' Simple License forbids distributing the file so it can be
// downloaded separately — which is exactly what public/media/ plus the public
// GitHub mirror does). The second reason is that no third-party padlock
// matches a library of flat, square-capped, 28-box glyphs; ours does, by
// construction.
//
// Two baked JSONs swapped on [data-theme], the AnimatedLogo pattern — Lottie
// bakes its colours and does not follow custom properties. The static SVG
// below is the SAME geometry and stays for two jobs: it is the resting frame
// before the player mounts, and it is the whole mark under reduced motion.
---

<div class="nda-toast" data-nda-toast hidden role="status" aria-live="polite">
  <span class="nda-toast__mark" data-nda-toast-mark>
    {
      /* locker.svg decoded, not redrawn — the same numbers the generator uses:
          body    outer 3,12->25,26 against inner 5,14->23,24 = a 2px stroke on
                  the 4,13 20x12 centreline rect
          shackle outer r=7 / inner r=5 about (14,9) = a centreline r=6 arc at
                  stroke-width 2, legs ending flat at y=12 (linecap: butt)
          slot    the filled 13,18 2x4 rect, unchanged
        If the icon ever changes, this and the generator both move. */
    }
    <svg
      class="nda-toast__static"
      viewBox="0 0 28 28"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="4" y="13" width="20" height="12" stroke="currentColor" stroke-width="2"></rect>
      <rect class="nda-toast__slot" x="13" y="18" width="2" height="4" fill="currentColor"></rect>
      <path
        class="nda-toast__shackle"
        d="M8 12V9a6 6 0 0 1 12 0v3"
        stroke="currentColor"
        stroke-width="2"></path>
    </svg>
  </span>
  <p class="nda-toast__text">Unlocked — every confidential project is open.</p>
</div>

<script>
  import { setWasmUrl } from '@lottiefiles/dotlottie-wc';
  setWasmUrl('/wasm/dotlottie-player.wasm');
</script>

<script>
  import { consumeNdaUnlockToast, prefersReducedMotion } from '@shared/lib';

  // Max's call. Long enough to read eleven words twice, and it is measured
  // from the moment the toast appears, so the ~1.1s of lock animation runs
  // inside it rather than before it. Nothing here is interactive.
  const HOLD_MS = 5000;
  // Matches --duration-base, which the leaving animation uses. Kept as a
  // number because setTimeout can't read a custom property.
  const EXIT_MS = 350;

  let holdTimer: number | undefined;
  let exitTimer: number | undefined;

  function clearTimers() {
    window.clearTimeout(holdTimer);
    window.clearTimeout(exitTimer);
  }

  // The players are CREATED on unlock, never shipped in the markup, and that
  // is load-bearing twice over. (1) Cost: almost nobody unlocks, so nobody
  // else pays for two player instances and two JSON fetches on every visit to
  // the home page. (2) Correctness: dotlottie-wc sizes its canvas buffer off a
  // ResizeObserver on its own box, and that observer never fires inside a
  // `display: none` subtree — the toast is `hidden` until it fires, so a
  // player mounted in the markup would keep the default 300x150 buffer and
  // get stretched to fill 24x24 the instant it appeared. Mounting them after
  // the toast is visible means they are measured at their real size. This is
  // the same trap AnimatedLogo documents, reached from the other direction.
  function mountLottie(mark: HTMLElement) {
    if (mark.dataset.mounted !== undefined) return;
    mark.dataset.mounted = '';
    for (const theme of ['dark', 'light'] as const) {
      const player = document.createElement('dotlottie-wc');
      player.className = `nda-toast__lottie nda-toast__lottie--${theme}`;
      player.setAttribute(
        'src',
        theme === 'dark' ? '/media/ui/lock-unlock.json' : '/media/ui/lock-unlock-light.json',
      );
      // Plays once and holds the last frame: the lock must stay open for the
      // rest of the hold, so no `loop`.
      player.setAttribute('autoplay', '');
      player.setAttribute('aria-hidden', 'true');
      mark.append(player);
    }
  }

  function initNdaUnlockToast() {
    const toast = document.querySelector<HTMLElement>('[data-nda-toast]');
    if (!toast) return;

    // Consume-on-read: this returns true exactly once per unlock, so a second
    // visit to this page in the same session is silent.
    if (!consumeNdaUnlockToast()) return;

    clearTimers();
    toast.removeAttribute('hidden');

    // Under reduced motion the static SVG is the whole mark — CSS renders it
    // already open — and no player, WASM or JSON is ever fetched.
    if (!prefersReducedMotion()) {
      const mark = toast.querySelector<HTMLElement>('[data-nda-toast-mark]');
      if (mark) mountLottie(mark);
    }

    holdTimer = window.setTimeout(() => {
      toast.classList.add('nda-toast--leaving');
      exitTimer = window.setTimeout(() => {
        toast.setAttribute('hidden', '');
        toast.classList.remove('nda-toast--leaving');
      }, EXIT_MS);
    }, HOLD_MS);
  }

  document.addEventListener('astro:page-load', initNdaUnlockToast);
  // A ClientRouter swap destroys this element, so a surviving timer would fire
  // against a detached node. Harmless, but there is no reason to leave it
  // running.
  document.addEventListener('astro:before-swap', clearTimers);
</script>

<style>
  .nda-toast {
    position: fixed;
    /* Centred, by auto margins between two edges rather than by
       translateX(-50%): the entrance and exit animations already own
       `transform`, and a centring transform there would have to be repeated
       in every keyframe of both (and in the reduced-motion overrides) to
       avoid snapping to the left edge mid-animation. Auto margins keep the
       two concerns apart. `width: max-content` is what gives the margins
       something to divide — a fixed box with both edges set would otherwise
       stretch the full width. */
    left: 0;
    right: 0;
    margin-inline: auto;
    width: max-content;
    bottom: var(--spacing-lg);
    /* Over ScrollToTop (500), under the mobile nav header (900) and its
       overlay (950) — a toast must never cover the menu that dismisses it. */
    z-index: 600;
    display: flex;
    align-items: center;
    /* Same icon+text row the NDA card badge uses: 8px gap, --color-icon-default.
       Height is the 24px mark plus 8px either side = 40px; the 14px/20px text
       sits inside that and never governs it. */
    gap: var(--spacing-sm);
    max-width: calc(100vw - 48px);
    padding: var(--spacing-sm) var(--spacing-md);
    /* No border and no radius: the site is square everywhere except the theme
       toggle, and the plate carries itself on --color-bg-muted against
       --color-bg-default in both themes. */
    background: var(--color-bg-muted);
    /* Purely an announcement — it must never eat a card click underneath. */
    pointer-events: none;
    animation: nda-toast-in var(--duration-base) var(--ease-reveal) both;
  }

  @media (min-width: 1024px) {
    .nda-toast {
      /* Centred on the CONTENT, not on the viewport: the nav is fixed at 153px
         and the page it sits beside starts there, so centring edge-to-edge
         would read ~76px left of the grid it belongs to. */
      left: 153px;
      bottom: 40px;
      max-width: min(420px, calc(100vw - 193px));
    }
  }

  .nda-toast--leaving {
    animation: nda-toast-out var(--duration-base) var(--ease-fade) both;
  }

  .nda-toast__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    color: var(--color-text-emphasis);
  }

  /* One 24px box holding up to three stacked marks — the static SVG plus the
     two colourways — so the row's height never changes as they swap. */
  .nda-toast__mark {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    /* The static SVG is currentColor; the players carry their colour baked in
       and ignore this. Both resolve to --color-icon-default either way. */
    color: var(--color-icon-default);
  }
  .nda-toast__static,
  .nda-toast__mark :global(.nda-toast__lottie) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The shackle leaves the 28 box as it swings; without this the open frames
     render with it cut off flat. */
  .nda-toast__static {
    overflow: visible;
  }
  /* Once a player is mounted it owns the mark. `visibility`, not `display` —
     see the ResizeObserver note in the script. */
  .nda-toast__mark[data-mounted] .nda-toast__static {
    visibility: hidden;
  }
  .nda-toast__mark :global(.nda-toast__lottie--light) {
    visibility: hidden;
  }
  :global([data-theme='light']) .nda-toast__mark :global(.nda-toast__lottie--dark) {
    visibility: hidden;
  }
  :global([data-theme='light']) .nda-toast__mark :global(.nda-toast__lottie--light) {
    visibility: visible;
  }

  @keyframes nda-toast-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nda-toast-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 767px) {
    .nda-toast {
      max-width: calc(100vw - 32px);
      bottom: var(--spacing-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The toast and its 5s hold stay — the message is the point. No player is
       ever created, and the static mark renders in its END state: the lock
       arrives already open rather than opening. The transforms mirror the
       Lottie's last frame exactly (30deg about the right leg, 1.5px lift). */
    .nda-toast,
    .nda-toast--leaving {
      animation: none;
    }
    .nda-toast__slot {
      /* The slot's own box is 13..15 / 18..22, so 50% 50% is its centre. */
      transform-box: fill-box;
      transform-origin: 50% 50%;
      transform: rotate(90deg);
    }
    .nda-toast__shackle {
      /* fill-box, or the origin resolves against the whole SVG viewport in
         WebKit. The path's geometry box is x 8..20 / y 3..12, so 100% 100% IS
         the right leg's base (20,12) — the hinge a real padlock turns on. */
      transform-box: fill-box;
      transform-origin: 100% 100%;
      transform: translateY(-1.5px) rotate(30deg);
    }
  }
</style>
