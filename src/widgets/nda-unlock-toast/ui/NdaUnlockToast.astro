---
// Marks the moment the NDA gate comes off, once per unlock.
//
// Before this, unlocking was silent: `tryUnlockNda` stored the key, and on the
// next visit to the grid ProjectGrid's `syncNdaMasks()` quietly stripped the
// confidential plates. The reader got the access with no acknowledgement that
// anything had changed site-wide.
//
// The trigger is a consume-on-read flag, not the unlock state itself — see
// `consumeNdaUnlockToast` in shared/lib/password-gate.ts for why those have to
// be two different signals. This widget is rendered by the page, not by
// ProjectGrid, so the grid's other consumer (/system's ComponentGallery) never
// fires it.
//
// THE MARK, and why it is inline SVG and not the Lottie this briefly shipped
// as. dotlottie-wc rasterises to a canvas of CSS-pixels x dpr, so a 24px mark
// gets a 24x24 buffer and our 2px stroke lands on ~1.7 device pixels — visibly
// stair-stepped arc, uneven stroke weight, chewed butt caps. Measured, not
// guessed; resizing the element post-mount does not re-allocate the buffer.
// Canvas is the wrong renderer for a thin-stroke glyph this small. SVG is
// resolution-independent, and `currentColor` means ONE asset covers both
// themes instead of two baked colourways.
//
// THE MOTION is Oleksandr Pronskyi's Lock/Unlock (dribbble.com/shots/2998435),
// which Max picked, redrawn in our outlined style. Its trick: the shackle
// RETRACTS DOWN INTO THE BODY, turns while it is hidden, and rises again
// already open. The body never moves and the arc never swings through open
// space — which is exactly where the previous attempt read as raw. The
// reference's body is a solid fill that occludes the shackle; ours is an
// outline with a hollow interior, so a clipPath at the body's top edge does
// the occluding instead, with the shackle painted BEFORE the body so the top
// stroke covers the last units of travel.
---

<div class="nda-toast" data-nda-toast hidden role="status" aria-live="polite">
  {
    /* locker.svg decoded, not redrawn:
        body    outer 3,12->25,26 against inner 5,14->23,24 = a 2px stroke on
                the 4,13 20x12 centreline rect
        shackle outer r=7 / inner r=5 about (14,9) = a centreline r=6 arc at
                stroke-width 2, legs ending flat at y=12 (linecap: butt)
        slot    the filled 13,18 2x4 rect
      At rest this is that icon to the pixel. The slot does NOT animate — the
      reference does not turn its keyhole, and one moving part reads cleaner
      than two. */
  }
  <svg class="nda-toast__lock" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="nda-toast-body-clip">
        {
          /* Everything above the body's top stroke. Generous on x and upward so
            the shackle can leave the 28 box as it turns; the only edge that
            matters is y=14, the bottom of that stroke. */
        }
        <rect x="-12" y="-14" width="52" height="28"></rect>
      </clipPath>
    </defs>
    <g clip-path="url(#nda-toast-body-clip)">
      <path
        class="nda-toast__shackle"
        d="M8 12V9a6 6 0 0 1 12 0v3"
        stroke="currentColor"
        stroke-width="2"></path>
    </g>
    {/* After the shackle, so the top stroke paints over it on the way in. */}
    <rect x="4" y="13" width="20" height="12" stroke="currentColor" stroke-width="2"></rect>
    <rect x="13" y="18" width="2" height="4" fill="currentColor"></rect>
  </svg>
  <p class="nda-toast__text">Unlocked — every confidential project is open.</p>
</div>

<script>
  import { consumeNdaUnlockToast } from '@shared/lib';

  // Max's call. Long enough to read eleven words twice, and it is measured
  // from the moment the toast appears, so the ~0.9s of lock animation runs
  // inside it rather than before it. Nothing here is interactive.
  const HOLD_MS = 5000;
  // Matches --duration-base, which the leaving animation uses. Kept as a
  // number because setTimeout can't read a custom property.
  const EXIT_MS = 350;

  let holdTimer: number | undefined;
  let exitTimer: number | undefined;

  function clearTimers() {
    window.clearTimeout(holdTimer);
    window.clearTimeout(exitTimer);
  }

  function initNdaUnlockToast() {
    const toast = document.querySelector<HTMLElement>('[data-nda-toast]');
    if (!toast) return;

    // Consume-on-read: this returns true exactly once per unlock, so a second
    // visit to this page in the same session is silent.
    if (!consumeNdaUnlockToast()) return;

    clearTimers();
    // Everything inside is `display: none` until this line — which is what
    // starts the whole animation timeline, keyframe delays included, at the
    // moment the toast appears rather than at page load.
    toast.removeAttribute('hidden');

    holdTimer = window.setTimeout(() => {
      toast.classList.add('nda-toast--leaving');
      exitTimer = window.setTimeout(() => {
        toast.setAttribute('hidden', '');
        toast.classList.remove('nda-toast--leaving');
      }, EXIT_MS);
    }, HOLD_MS);
  }

  document.addEventListener('astro:page-load', initNdaUnlockToast);
  // A ClientRouter swap destroys this element, so a surviving timer would fire
  // against a detached node. Harmless, but there is no reason to leave it
  // running.
  document.addEventListener('astro:before-swap', clearTimers);
</script>

<style>
  .nda-toast {
    position: fixed;
    /* Centred, by auto margins between two edges rather than by
       translateX(-50%): the entrance and exit animations already own
       `transform`, and a centring transform there would have to be repeated
       in every keyframe of both (and in the reduced-motion overrides) to
       avoid snapping to the left edge mid-animation. Auto margins keep the
       two concerns apart. `width: max-content` is what gives the margins
       something to divide — a fixed box with both edges set would otherwise
       stretch the full width. */
    left: 0;
    right: 0;
    margin-inline: auto;
    width: max-content;
    bottom: var(--spacing-lg);
    /* Over ScrollToTop (500), under the mobile nav header (900) and its
       overlay (950) — a toast must never cover the menu that dismisses it. */
    z-index: 600;
    display: flex;
    align-items: center;
    /* Same icon+text row the NDA card badge uses: 8px gap, --color-icon-default.
       Height is the 24px mark plus 8px either side = 40px; the 14px/20px text
       sits inside that and never governs it. */
    gap: var(--spacing-sm);
    max-width: calc(100vw - 48px);
    padding: var(--spacing-sm) var(--spacing-md);
    /* No border and no radius: the site is square everywhere except the theme
       toggle, and the plate carries itself on --color-bg-muted against
       --color-bg-default in both themes. */
    background: var(--color-bg-muted);
    /* Purely an announcement — it must never eat a card click underneath. */
    pointer-events: none;
    animation: nda-toast-in var(--duration-base) var(--ease-reveal) both;
  }

  @media (min-width: 1024px) {
    .nda-toast {
      /* Centred on the CONTENT, not on the viewport: the nav is fixed at 153px
         and the page it sits beside starts there, so centring edge-to-edge
         would read ~76px left of the grid it belongs to. */
      left: 153px;
      bottom: 40px;
      max-width: min(420px, calc(100vw - 193px));
    }
  }

  .nda-toast--leaving {
    animation: nda-toast-out var(--duration-base) var(--ease-fade) both;
  }

  .nda-toast__text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    color: var(--color-text-emphasis);
  }

  .nda-toast__lock {
    display: block;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    /* The rotated shackle reaches just past the top of the 28 box. */
    overflow: visible;
    color: var(--color-icon-default);
  }

  .nda-toast__shackle {
    /* Flat leg ends, as in the icon. */
    stroke-linecap: butt;
    /* fill-box, or the origin resolves against the whole SVG viewport in
       WebKit. The path's geometry box is x 8..20 / y 3..12, so 0% 100% is the
       LEFT leg's base (8,12) — the hinge, matching the reference, where the
       right leg is the one that lifts clear. */
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: nda-lock-open 900ms both;
  }

  /* The whole idea, in five stops. 14 units of travel is what it takes to put
     the shackle fully under the body's top stroke in BOTH orientations: turned
     -30deg its highest ink sits at y≈0.2, and the clip edge is y=14. Getting
     that number wrong is the one way this breaks — too little and the arc is
     visibly still there when it turns. */
  @keyframes nda-lock-open {
    /* A beat of stillness first, so the retraction is noticed rather than
       already underway when the toast finishes sliding in. */
    0%,
    15% {
      transform: translateY(0) rotate(0deg);
      /* Accelerating: it is being drawn in, not falling. */
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4);
    }
    48% {
      transform: translateY(14px) rotate(0deg);
      animation-timing-function: linear;
    }
    /* Turns while fully hidden. Invisible by construction, which is why the
       arc never has to sweep through open space. */
    54% {
      transform: translateY(14px) rotate(-30deg);
      animation-timing-function: cubic-bezier(0.15, 0.7, 0.3, 1);
    }
    /* Overshoots by just over a unit on the way out, then sets down. */
    88% {
      transform: translateY(-1.2px) rotate(-30deg);
      animation-timing-function: cubic-bezier(0.4, 0, 0.5, 1);
    }
    100% {
      transform: translateY(0) rotate(-30deg);
    }
  }

  @keyframes nda-toast-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nda-toast-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 767px) {
    .nda-toast {
      max-width: calc(100vw - 32px);
      bottom: var(--spacing-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The toast and its 5s hold stay — the message is the point. The lock
       arrives already open rather than opening, in the keyframe's end pose. */
    .nda-toast,
    .nda-toast--leaving {
      animation: none;
    }
    .nda-toast__shackle {
      animation: none;
      transform: rotate(-30deg);
    }
  }
</style>
