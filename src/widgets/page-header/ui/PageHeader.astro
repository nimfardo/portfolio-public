---
// Figma "header" organism, now canvas 2910:2049: page-name on the left, and a
// right group holding the Download CV button + theme-toggle. Sitting above
// content on desktop. Desktop-only — mobile's own header (widgets/navigation)
// is logo+hamburger only, and the mobile overlay already carries the
// theme-toggle, so this would be redundant below 1024px.
//
// The CV button arrived in feat-100 and this component being desktop-only is
// load-bearing for how it was wired: because nothing here renders below
// 1024px, CV had to STAY in the mobile overlay's nav list. It is the sidebar
// copy that went (see `overlayOnly` in navigation's nav-items). Max accepted
// that "always visible" therefore means desktop; on phones CV is still one tap
// inside the hamburger.
//
// The glyph is `download`, and the canvas will not tell you that by name — the
// layer is called `right-arrow` (the Button master's slot name) while the
// exported path is the project's own download icon scaled 28 -> 24, checked
// coordinate by coordinate. Third time that trap has come up this week.
import { ButtonText, Icon } from '@shared/ui';
import { CV_HREF, CV_LABEL } from '@shared/config';
import { ThemeToggle } from '@features/theme-toggle';

interface Props {
  title: string;
  showBack?: boolean;
  backHref?: string;
  class?: string;
}

const { title, showBack = false, backHref = '/', class: className } = Astro.props;
---

<div class:list={['page-header', className]}>
  <div class="page-header__title-group">
    {
      showBack && (
        <a href={backHref} class="page-header__back" aria-label="Back">
          <Icon name="arrow-left" size={32} />
        </a>
      )
    }
    <span class="page-header__title">{title}</span>
  </div>
  <div class="page-header__actions">
    <ButtonText href={CV_HREF} external icon="download" class="page-header__cv">
      {CV_LABEL}
    </ButtonText>
    <ThemeToggle />
  </div>
</div>

<style>
  .page-header {
    display: none;
  }

  @media (min-width: 1024px) {
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      /* Pinned to the top on scroll (feat-159). `sticky`, not `fixed`: it
         keeps its place in flow, so nothing needs a compensating offset and
         no page had to learn the header's height. Works because no ancestor
         scrolls or clips — checked; the only `overflow: hidden` in
         global.css is .visually-hidden. */
      position: sticky;
      top: 0;
      /* Above content and the ScrollToTop button (500), below the mobile
         header (900) and the overlay (950) — which never coexist with this
         anyway, since this component stops rendering below 1024px. */
      z-index: 800;

      /* ── Vertical box, and why these numbers ──────────────────────────
         Figma's real gap on both Home and CONNECTIS is 40px above and below
         the 48px header (`header` instance at y=40, next element exactly
         40px after), NOT the 48px --spacing-2xl token (bug-012).

         Once the bar is sticky it needs its own padding, or the backdrop
         hugs the type with content running right up to the viewport edge.
         The 40px is therefore SPLIT — 24px margin plus 16px padding — so
         the resting layout is byte-identical to before (24 + 16 = 40 on
         each side) while the stuck bar gets a 16px interior. Change one of
         these three and the other two have to move with it.

         `box-sizing: border-box` is global, so `height` here is the OUTER
         box: 48px of content plus the two 16px pads. Writing `height: 48px`
         and adding padding would have crushed the content band to 16px. */
      height: calc(48px + 2 * var(--spacing-md));
      padding-block: var(--spacing-md);
      /* The 40px side gutter lives here now, not on each page (feat-159).
         Five pages set `:global(.x__header) { padding: 0 40px }` and Home
         inset the whole <main> instead, which meant the header's own box was
         full-bleed on five pages and already inset on the sixth — so a
         backdrop painted on this element would have spanned the content
         width in five places and floated as a slab in one. One owner. */
      padding-inline: 40px;
      margin-top: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);

      /* ── The backdrop ────────────────────────────────────────────────
         Nothing at rest; a tint over a blur once the page moves. Both the
         tint and the hairline are derived from theme tokens through
         color-mix rather than pinned as two hexes, so this flips with the
         theme like every other surface and there is no second palette to
         keep in step.

         The blur is declared unconditionally and the TINT is what animates.
         `backdrop-filter` cannot transition from `none` to a value — it
         snaps — and toggling it on scroll also makes the browser promote and
         drop a layer mid-scroll, which is exactly when it cannot afford to.
         Left on, it is a no-op while the tint is transparent, because a blur
         of a flat page background is that same flat colour. */
      background: color-mix(in srgb, var(--color-bg-default) 0%, transparent);
      backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid transparent;
      transition:
        background-color 0.25s ease,
        border-color 0.25s ease;
    }
    /* `data-scrolled` is set on <html> by shared/lib/scroll-state.ts past
       8px. 72% keeps the bar reading as glass rather than a solid strip —
       at 100% the blur is invisible and it is just a bar, below ~60% the
       type loses its footing over a busy hero. */
    :global(html[data-scrolled]) .page-header {
      background: color-mix(in srgb, var(--color-bg-default) 72%, transparent);
      border-bottom-color: var(--color-border-default);
    }
    @media (prefers-reduced-motion: reduce) {
      .page-header {
        transition: none;
      }
    }
    .page-header__title-group {
      display: flex;
      align-items: center;
      gap: var(--spacing-lg);
    }
    /* 16, re-measured off master 2078:375 after Max tightened it — the
       `actions` group is 288 wide with the button at x=0 (174) and the toggle
       frame at x=190. It was 40 when the button was an outlined 187x48 block;
       a borderless text button needs less air beside it, or the two read as
       unrelated items rather than one control cluster. `--spacing-md`, not a
       raw 16, since 16 is on the ramp (unlike the 40 it replaces). */
    .page-header__actions {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
    }
    /* Manrope/xl/regular, synced from the "header" master (node 2304:1538,
       bug-033). Was 2xl/bold with a hardcoded 48px line-height — that was
       the bug-005 style-vs-variable divergence special case, which no
       longer applies now that this style sits cleanly on its own size
       step's tokens. */
    .page-header__title {
      font-family: var(--font-family-body);
      font-size: var(--font-size-xl);
      line-height: var(--font-line-height-xl);
      font-weight: var(--font-weight-regular);
      color: var(--color-text-primary);
    }
    .page-header__back {
      display: flex;
      color: var(--color-icon-default);
    }
  }
</style>
