---
// Heading + one or more stacked media+paragraph blocks — reused for
// Challenge (1 block) and Deliverables (2 blocks, one heading over both:
// Brand Development + Design System merged into one Figma section).
//
// Each block's media is the same image|video union the hero (feat-031) and
// the process steps (feat-026) already use, so Deliverables' two blocks can
// be videos while Challenge stays a still.
import { Heading } from '@shared/ui';
import { Media } from '@entities/media';
import { LinkCards } from '@entities/project';
import { staggerDelay } from '@shared/lib';
import type { ContentBlock } from '../model/types';

interface Props {
  heading: string;
  blocks: ContentBlock[];
  class?: string;
}

const { heading, blocks, class: className } = Astro.props;
---

<section class:list={['section-grid', 'content-section', className]}>
  <Heading class="section-grid__aside content-section__heading">{heading}</Heading>
  <div class="section-grid__body content-section__body">
    {
      blocks.map((block, i) => (
        <div class="content-section__block" data-reveal style={`--reveal-delay: ${staggerDelay(i, 100)}`}>
          {block.media.type === 'image' ? (
            <img
              class="content-section__image"
              src={block.media.image}
              alt={block.media.imageAlt}
              loading="lazy"
              data-media-skeleton
            />
          ) : (
            <Media
              type="video"
              class="content-section__image"
              src={block.media.src}
              poster={block.media.poster}
              alt={block.media.alt}
            />
          )}
          {/* Slots into the block's own 64px column gap, which is exactly
              Figma's media -> links -> text rhythm. */}
          {block.linkCards && <LinkCards cards={block.linkCards} />}
          <p class="section-prose content-section__text">{block.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Grid, column spans and the 1023px collapse come from .section-grid in
     global.css — shared with the four other case-study sections (ref-005). */
  .content-section__body {
    display: flex;
    flex-direction: column;
    /* 160px between stacked blocks (Deliverables' 2 blocks) — matches the
       page's own section rhythm, per Figma. */
    gap: 160px;
  }
  .content-section__block {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  /* :global() — the video branch's class merges onto Media's own rendered
     root <div>, which carries Media.astro's astro-cid, not this
     component's (same classlist-merge gotcha as ProcessAccordion's
     .process-step__image); :global() still matches this component's own
     <img> in the image branch, so one rule covers both. object-fit is
     inert on Media's wrapper div, but Media's internal CSS already applies
     object-fit:cover to the <video>, so both branches crop identically. */
  :global(.content-section__image) {
    width: 100%;
    aspect-ratio: 1071 / 630;
    object-fit: cover;
  }
  /* Type ramp comes from .section-prose in global.css. */
  .content-section__text {
    /* defenceSystems's paragraphs carry a real newline after their lead-in sentence
       (authored that way on canvas); CONNECTIS's single-line texts are
       unaffected. */
    white-space: pre-line;
  }
</style>
