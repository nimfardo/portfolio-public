---
import circleDoodle from './circle-doodle.svg?raw';
import { Button, AnimatedFlame, Heading } from '@shared/ui';

interface Props {
  heading: string;
  /** Optional since feat-033 — defenceSystems's closing section has no Behance link. */
  behanceUrl?: string;
  /** A second, generic external link+label pair — feat-122's Gallery page
   * needs "Check on Unsplash" instead of Behance, and every existing
   * project's `behanceUrl` stays exactly as-is rather than being
   * generalized into this (would touch every project's content file for
   * no reason). Independent of behanceUrl; a page could carry both, though
   * none does today. */
  linkLabel?: string;
  linkHref?: string;
}

const { heading, behanceUrl, linkLabel, linkHref } = Astro.props;
---

<section class="section-grid retrospective">
  <Heading class="section-grid__aside retrospective__heading">{heading}</Heading>
  <div class="section-grid__body retrospective__body" data-reveal>
    <p class="section-prose retrospective__text"><slot /></p>
    {
      behanceUrl && (
        <Button type="solid" href={behanceUrl} class="retrospective__button">
          Check on Behance
        </Button>
      )
    }
    {
      linkHref && linkLabel && (
        <Button type="solid" href={linkHref} class="retrospective__button">
          {linkLabel}
        </Button>
      )
    }
    <div class="retrospective__mark">
      <span class="retrospective__mark-ring" set:html={circleDoodle} />
      <AnimatedFlame class="retrospective__flame" />
    </div>
  </div>
</section>

<style>
  /* Grid, column spans and the 1023px collapse come from .section-grid in
     global.css; the type ramp from .section-prose there (ref-005). */
  .retrospective__body {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .retrospective__text {
    /* defenceSystems's closing text carries a real newline after its lead-in
       sentence (authored that way on canvas); single-line texts are
       unaffected. */
    white-space: pre-line;
  }
  /* :global() — class merges onto Button's own rendered <a>/<button>, which
     carries Button.astro's astro-cid, not this component's. Without this,
     the button stretches to the full column width via the flex-column
     parent's default align-items:stretch — Figma has it fixed at 320px. */
  :global(.retrospective__button) {
    align-self: flex-start;
  }
  /* The mark sits a touch above the ring's centre (Max's call, measured off
     his mockup) — the ring itself stays optically centred and does not move.
     :global for the same reason the button above needs it: this class lands
     on AnimatedFlame's own <svg>, which carries that component's astro-cid
     rather than this one's, so a scoped selector would never match it. */
  :global(.retrospective__flame) {
    position: relative;
    top: -6px;
  }
  .retrospective__mark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 128px;
    height: 128px;
    color: var(--color-icon-default);
  }
  .retrospective__mark-ring {
    position: absolute;
    inset: 0;
    display: flex;
    /* Slow continuous spin on the ring's lettering — the mark it surrounds
       stays centred and never rotates. It does animate now (AnimatedFlame
       runs its own 1.00s frame loop), but that is the mark's business, not
       the ring's; the two loops are independent on purpose and their periods
       are deliberately unrelated. No token fits a multi-second
       decorative loop (tokens.css's durations are all sub-second UI
       transitions), so this is a literal value scoped to this component,
       same precedent as the hero scroll-cue's bounce animation. */
    animation: retrospective-ring-spin 45s linear infinite;
  }
  .retrospective__mark-ring :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @keyframes retrospective-ring-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .retrospective__mark-ring {
      animation: none;
    }
  }

</style>
