---
import { PROJECTS } from '@entities/project';
import { staggerDelay } from '@shared/lib';
import ProjectCard from './ProjectCard.astro';
import ProjectCardEmpty from './ProjectCardEmpty.astro';

// A last row that doesn't fill leaves dead space beside it (13 projects = one
// lone card on the fifth row). Figma's answer is the project-card `state=empty`
// variant repeated to complete the row — canvas node 3078:4506 shows the real
// card followed by two of them.
//
// The count is derived, never literal, because the column count is responsive:
// the same 13 cards leave 2 empty slots at 3 columns, 1 at 2 columns, and none
// at 1 column (mobile, which has no gap to fill and gets no fillers at all).
// `cols` records which column counts a given filler is needed at, and
// ProjectCardEmpty hides itself at the others. Add a 14th project and this
// corrects itself with no edit here.
const count = PROJECTS.length;
const fillersAt3 = (3 - (count % 3)) % 3;
const fillersAt2 = (2 - (count % 2)) % 2;
const fillers = Array.from({ length: Math.max(fillersAt3, fillersAt2) }, (_, i) => {
  const cols: string[] = [];
  if (i < fillersAt3) cols.push('3');
  if (i < fillersAt2) cols.push('2');
  // Continues the cards' own row-wise stagger (index % 3) rather than
  // restarting it, so a filler rises with the real card beside it.
  return { cols: cols.join(' '), delay: staggerDelay(count + i, 80, 3) };
});
---

<div class="project-grid" data-project-grid>
  {
    PROJECTS.map((project, i) => (
      <ProjectCard project={project} revealDelay={staggerDelay(i, 80, 3)} eager={i < 3} />
    ))
  }
  {fillers.map((filler) => <ProjectCardEmpty cols={filler.cols} revealDelay={filler.delay} />)}
</div>

<script>
  import { isNdaUnlocked } from '@shared/lib';

  // Dim-siblings-on-hover (ProjectCard.astro's `.project-grid--card-hover`
  // rule) needs its trigger to be an actual card, not the grid container —
  // a bare `.project-grid:hover` fires for the gap space between cards too
  // (Max caught this reading as a bug). `:has(.project-card:hover)` is the
  // pure-CSS equivalent but didn't reliably invalidate style on sibling
  // cards when tested, so this uses plain non-bubbling mouseenter/mouseleave
  // on each card instead — simple, and every current AND future page-load's
  // cards need this re-wired after `astro:page-load` (ClientRouter swaps
  // aren't guaranteed to keep this exact set of nodes around).
  function initProjectGridHover() {
    const grid = document.querySelector<HTMLElement>('[data-project-grid]');
    if (!grid) return;
    grid.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
      card.addEventListener('mouseenter', () => grid.classList.add('project-grid--card-hover'));
      card.addEventListener('mouseleave', () => grid.classList.remove('project-grid--card-hover'));
    });
  }

  // One shared password unlocks every NDA project (shared/lib/password-gate.ts),
  // so a single check here hides the mask — and swaps the footer icon back to
  // arrow-right — on every NDA card on this page, not just the one the
  // visitor happened to unlock it on.
  function syncNdaMasks() {
    if (!isNdaUnlocked()) return;
    document
      .querySelectorAll<HTMLElement>('[data-project-grid] [data-nda-mask]')
      .forEach((mask) => mask.setAttribute('hidden', ''));
    document
      .querySelectorAll<HTMLElement>('[data-project-grid] [data-nda-icon="locked"]')
      .forEach((icon) => icon.setAttribute('hidden', ''));
    document
      .querySelectorAll<HTMLElement>('[data-project-grid] [data-nda-icon="unlocked"]')
      .forEach((icon) => icon.removeAttribute('hidden'));
  }

  document.addEventListener('astro:page-load', initProjectGridHover);
  document.addEventListener('astro:page-load', syncNdaMasks);
</script>

<style>
  .project-grid {
    display: grid;
    /* minmax(0, 1fr), not bare 1fr: a bare 1fr track's minimum width
       defaults to auto (its content's min-content size), so a card with
       wide content (e.g. the NDA badge, or a long name) can force its
       column wider than its fair share once the grid is narrow enough —
       confirmed uneven (237/197/271px) in /system's narrower gallery
       column, though the wide home-page grid never exposed it. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* 40px — Figma project-grid's real itemSpacing (row and column both),
       re-pulled after Max's update. Not on the token scale. */
    gap: 40px;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
      /* Not --spacing-md (16px): that's the same gap ProjectCard already
         uses between its own image and footer, so a flat 16px here read as
         one continuous list instead of separate cards. --spacing-lg keeps
         the same ~1.5x ratio the 1023px breakpoint already has against that
         16px internal gap. */
      gap: var(--spacing-lg);
    }
  }
</style>
