---
import { Icon } from '@shared/ui';
import type { Project } from '@entities/project';

interface Props {
  project: Project;
  revealDelay?: string;
  eager?: boolean;
}

const { project, revealDelay, eager } = Astro.props;
---

<a
  href={`/projects/${project.slug}`}
  class="project-card"
  data-reveal
  style={revealDelay ? `--reveal-delay: ${revealDelay}` : undefined}
>
  <div class="project-card__media">
    <img
      src={project.thumbnail}
      alt={project.name}
      loading={eager ? undefined : 'lazy'}
      data-media-skeleton
    />
    {
      project.access === 'nda' && (
        <div class="project-card__nda-plate" data-nda-mask>
          <div class="project-card__nda-track">
            {
              Array.from({ length: 12 }).map(() => (
                <span class="project-card__nda-badge">
                  <Icon name="locker" size={16} />
                  <span class="project-card__nda-text">Confidential — walkthrough on request</span>
                </span>
              ))
            }
          </div>
        </div>
      )
    }
  </div>
  <div class="project-card__footer">
    <span class="project-card__name">{project.name}</span>
    <span class="project-card__meta">
      {
        project.access === 'nda' ? (
          <>
            <span data-nda-icon="locked">
              <Icon name="key" size={28} class="project-card__arrow" />
            </span>
            <span data-nda-icon="unlocked" hidden>
              <Icon name="arrow-right" size={28} class="project-card__arrow" />
            </span>
          </>
        ) : (
          <Icon name="arrow-right" size={28} class="project-card__arrow" />
        )
      }
    </span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 515 / 400;
    overflow: hidden;
    transition: opacity var(--duration-base) var(--ease-fade);
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Figma's nda-plate component (node 3178:2582, colours re-synced
     2026-09-15) — a solid, bottom-anchored caption bar. Replaces the old full-bleed
     backdrop-blur + centered lock icon, which went muddy on busy photos
     and carried no label. The photo above the plate stays sharp and in
     color. Hidden by ProjectGrid's script once isNdaUnlocked() is true
     (one shared password unlocks every NDA card site-wide, not just the
     one the visitor entered it on). */
  .project-card__nda-plate {
    position: absolute;
    inset: auto 0 0 0;
    overflow: hidden;
    padding: var(--spacing-sm) var(--spacing-md);
    /* Canvas fill is #1A0F05, which IS --color-bg-subtle in dark. Checked
       against the node on the 2026-09-15 re-sync and deliberately left as
       the token rather than pinned to the hex: the canvas only specs dark,
       and the plate has to flip with the theme like every other surface.
       Recorded so the next re-sync doesn't re-litigate it. */
    background: var(--color-bg-subtle);
  }
  /* Figma's own reference for this (node 3206:2470) shows the badge
     duplicated side-by-side with no keyframe data attached — read as "this
     is the loop unit," not a literal fixed 2-copy layout. 12 copies split
     into two identical halves (6 + 6) comfortably outrun any real card
     width (mobile single-column up to ~700px, desktop 3-col ~530px), so
     the track never runs out of content mid-loop. Animating the whole
     track by exactly -50% of its own width is what makes the loop
     seamless regardless of how many copies make up each half — at -50%
     the second half sits exactly where the first half started. */
  .project-card__nda-track {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    width: max-content;
    animation: project-card-nda-scroll 192s linear infinite;
  }
  @keyframes project-card-nda-scroll {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card__nda-track {
      animation: none;
    }
  }
  .project-card__nda-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;
    /* Matches the text below it. The canvas gives no fill for this node —
       it reads back as an SVG instance with no resolvable colour — so this
       is inferred from the pairing: icon and label are one row frame with an
       8px gap, and the two moved together on every previous sync. If Figma
       ever wants them different, this is the line that is a guess. */
    color: var(--color-icon-default);
  }
  .project-card__nda-text {
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
    line-height: var(--font-line-height-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    /* #EFCBA6 on canvas = --color-text-primary in dark. Was
       --color-text-accent (#e0964d), which is the real change in the
       2026-09-15 re-sync; it also takes the badge from 7.75:1 to 12.35:1
       against the plate. */
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  /* Explicit override — this rule's own `display: flex` above ties the
     `[hidden]` attribute selector on specificity, so the attribute alone
     can't be trusted to actually hide it once unlocked. */
  .project-card__nda-plate[hidden] {
    display: none;
  }

  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    /* 16px inset both sides — Figma's updated hover master pads the name
       and the NDA-badge+arrow group in from the card edges. */
    padding: 0 var(--spacing-md);
    transition: opacity var(--duration-fast) var(--ease-fade);
  }
  /* Hover-to-reveal only on devices that can actually hover with a
     precise pointer. Gating opacity:0 behind this (rather than applying
     it unconditionally and un-hiding on :hover) means touch devices —
     which never fire a real, sustained :hover — see the name/arrow
     footer always, instead of it being permanently invisible until tap. */
  @media (hover: hover) and (pointer: fine) {
    .project-card__footer {
      opacity: 0;
    }
    .project-card:hover .project-card__footer {
      opacity: 1;
    }

    /* Dim-siblings-on-hover, adapted from wearemotto.com's `.h-fade-invert`
       (wiki/concepts/motto-motion-patterns.md). Trigger is a JS-toggled
       `.project-grid--card-hover` class (see ProjectGrid.astro's script),
       not a bare `.project-grid:hover` — that fired for the gap space
       between cards too, dimming everything just from moving the cursor
       through the gutters (caught by Max). A `:has(.project-card:hover)`
       CSS-only version was tried first but didn't reliably invalidate style
       on sibling cards when tested live, so this uses an explicit class
       instead. `:global()` is required since `.project-grid` belongs to
       ProjectGrid.astro, a different component's scope (same gotcha as the
       Icon color race in bug-002/bug-004). */
    :global(.project-grid--card-hover) .project-card__media {
      opacity: 0.4;
    }
    .project-card:hover .project-card__media {
      opacity: 1;
    }
  }
  .project-card__name {
    min-width: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .project-card__meta {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--spacing-md);
  }
  /* :global() required — `class="project-card__arrow"` merges onto Icon's
     own rendered <span> (class:list={['icon', className]}), so the element
     only carries Icon.astro's astro-cid, never this component's. Without
     :global() the compiled attribute-selector never matches and the color
     silently falls through to inherited body text color instead. */
  :global(.project-card__arrow) {
    flex-shrink: 0;
    color: var(--color-icon-emphasis);
  }
</style>
