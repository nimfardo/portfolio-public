---
// Desktop: persistent 153px left sidebar (Figma node 2006:347), shown at
// laptop width and up. Below that: a compact header + full-screen overlay
// (Figma mock, node 2239:387 / 2240:2, signed off 2026-07-24). Both render
// server-side; CSS media queries pick which is visible — no JS/FOUC needed
// for the layout switch itself, only for the overlay's open/close state.
// Logo: the desktop sidebar uses AnimatedLogo (hover plays the monogram
// forward, unhover reverses it) now that Max's replacement export landed
// (feat-116, raw/max-logo.json). Mobile header and overlay stay on the
// plain static Logo — no hover on touch, and duplicating the Lottie web
// component there would cost weight for an interaction that can't fire.
import { ButtonText, Logo, AnimatedLogo, Icon } from '@shared/ui';
import { CV_HREF, CV_LABEL } from '@shared/config';
import { ThemeToggle } from '@features/theme-toggle';
import { MobileNavToggle } from '@features/mobile-nav-toggle';
import NavItem from './NavItem.astro';
import { NAV_ITEMS } from '../model/nav-items';

// GitHub joined in feat-082 (canvas node I2793:3257;2778:2970), which also
// makes it site-wide rather than an /about card — the rebuilt page has no link
// grid to hold one any more. Points at the profile (Max's call, 2026-08-29,
// overriding the earlier glacier-flow-only choice).
const SOCIAL_LINKS = [
  {
    name: 'linkedin' as const,
    href: 'https://www.linkedin.com/in/maksym-shturma-680292149/',
    label: 'LinkedIn',
  },
  { name: 'behance' as const, href: 'https://www.behance.net/shturma', label: 'Behance' },
  { name: 'github' as const, href: 'https://github.com/nimfardo', label: 'GitHub' },
];

const currentPath = Astro.url.pathname;
---

<nav id="nav-desktop" class="nav-desktop" aria-label="Primary" transition:persist>
  <div class="nav-desktop__top">
    <a href="/" aria-label="Home">
      <AnimatedLogo size={64} />
    </a>
    <ul class="nav-desktop__items">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <NavItem
              href={item.href}
              active={currentPath === item.href}
              external={item.external}
              icon={item.icon}
            >
              {item.label}
            </NavItem>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="nav-desktop__links">
    {
      SOCIAL_LINKS.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
          <Icon name={link.name} size={32} />
        </a>
      ))
    }
  </div>
</nav>

<header id="nav-mobile-header" class="nav-mobile-header" transition:persist>
  <a href="/" aria-label="Home">
    <Logo size={40} />
  </a>
  <button
    type="button"
    class="nav-mobile-header__trigger"
    data-mobile-nav-trigger
    aria-expanded="false"
    aria-controls="mobile-nav-overlay"
    aria-label="Open menu"
  >
    <Icon name="menu" size={28} />
  </button>
</header>

<div
  id="mobile-nav-overlay"
  class="nav-mobile-overlay"
  data-mobile-nav-overlay
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  transition:persist
>
  <div class="nav-mobile-overlay__top">
    <a href="/" aria-label="Home">
      <Logo size={40} />
    </a>
    <button
      type="button"
      class="nav-mobile-overlay__close"
      data-mobile-nav-close
      aria-label="Close menu"
    >
      <Icon name="close" size={28} />
    </button>
  </div>

  <div class="nav-mobile-overlay__content">
    <ul class="nav-mobile-overlay__items">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <NavItem
              href={item.href}
              active={currentPath === item.href}
              external={item.external}
              icon={item.icon}
              large
            >
              {item.label}
            </NavItem>
          </li>
        ))
      }
      {
        /* CV sits INSIDE the list, after the three routes — canvas 2240:2 puts
          it there, and the list is `align-items: center` in both places, so
          the component's own 20/17 padding centres it without an override.
          An earlier attempt zeroed the left padding to "align" it and pushed
          the label 8.5px off-centre; the render caught what the assumption
          missed. */
      }
      <li>
        <ButtonText href={CV_HREF} external icon="download" class="nav-mobile-overlay__cv">
          {CV_LABEL}
        </ButtonText>
      </li>
    </ul>
    <div class="nav-mobile-overlay__links">
      {
        SOCIAL_LINKS.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
            <Icon name={link.name} size={32} />
          </a>
        ))
      }
    </div>
  </div>

  <div class="nav-mobile-overlay__footer">
    <ThemeToggle />
  </div>
</div>

<MobileNavToggle />

<script>
  // Navigation persists across ClientRouter swaps (transition:persist), so
  // its `active` prop — computed server-side from Astro.url.pathname at the
  // *old* page's render — never gets recomputed on client-side navigation.
  // Re-derive it from the real URL after every load/swap instead. This also
  // means the underline transition (NavItem.astro) animates when it moves.
  function syncActiveNavItem() {
    document.querySelectorAll<HTMLAnchorElement>('.nav-item').forEach((item) => {
      const isActive = item.getAttribute('href') === location.pathname;
      const wasActive = item.hasAttribute('aria-current');
      if (isActive === wasActive) return;
      if (isActive) {
        item.setAttribute('aria-current', 'page');
      } else {
        item.removeAttribute('aria-current');
      }
    });
  }
  document.addEventListener('astro:page-load', syncActiveNavItem);
</script>

<style>
  /* --- Desktop sidebar (Figma: 153x1080, 40px padding all sides) --- */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: fixed;
      inset: 0 auto 0 0;
      width: 153px;
      padding: 40px;
      background: var(--color-bg-default);
    }
    .nav-desktop__top {
      display: flex;
      flex-direction: column;
      gap: 40px;
    }
    .nav-desktop__top > a {
      display: flex;
    }
    .nav-desktop__items {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    /* One row, centred in the full sidebar — canvas node
       I2793:3257;2778:2586, which sits at x=20.5 and is 112px wide.

       GRID with `grid-auto-flow: column`, not a flex row. Column flow has no
       wrap concept, so a single line is guaranteed by CONSTRUCTION rather than
       by policy: there is no `flex-wrap` here for a later edit to flip back to
       `wrap`, which is exactly how the second line got in (feat-082 wrapped the
       set 2+1 deliberately, and bug-056 turned that off with `nowrap`). Max
       reported the two-line state twice, so this removes the property that can
       cause it instead of setting it correctly.

       Arithmetic, and it now carries slack. The content column is 73px;
       -24px each side makes the row 121px, against 3x32 + 2x8 = 112px of
       icons — 9px spare. Centring keeps the group canvas-exact regardless:
       40 - 24 + (121 - 112) / 2 = 20.5px for the first icon, so 20.5 / 60.5 /
       100.5 as on canvas. The earlier -19.5px gave a 112px row for 112px of
       content, i.e. ZERO slack — correct, but flush against its own contents
       and the kind of exact fit that breaks on the next change.

       ⚠ CEILING: three 32px icons at an 8px gap is 112px, and that is what
       fits. A fourth needs 152px against the 121px available, which no amount
       of slack absorbs — it would overflow the sidebar. Adding a social link is
       a design decision (smaller icons, tighter gap, or two rows on purpose),
       not a CSS tweak. This row also sits 19.5px outside the 40px padding grid
       the logo, nav items and page gutters align to; that misalignment is
       intentional canvas fidelity, chosen by Max on 2026-08-23. */
    .nav-desktop__links {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      justify-content: center;
      gap: var(--spacing-sm);
      margin-inline: -24px;
    }
    .nav-desktop__links a {
      display: flex;
      color: var(--color-icon-default);
    }
  }

  /* --- Mobile header (below 1024px, Figma: 390x64) --- */
  .nav-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: fixed;
    inset: 0 0 auto 0;
    height: 64px;
    padding: 12px 20px;
    z-index: 900;
    /* Same frosted treatment as the desktop PageHeader (feat-159) — see that
       file for why the blur is unconditional and only the tint animates, and
       why both values are color-mixed off the theme token rather than pinned.
       This header was a solid --color-bg-default with a permanent hairline;
       it now starts transparent and earns both on scroll, so the top of a
       page reads as one surface instead of a band across the hero. */
    background: color-mix(in srgb, var(--color-bg-default) 0%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  :global(html[data-scrolled]) .nav-mobile-header {
    background: color-mix(in srgb, var(--color-bg-default) 72%, transparent);
    border-bottom-color: var(--color-border-default);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-mobile-header {
      transition: none;
    }
  }
  /* The logo anchors are plain inline elements around an inline-flex span,
     so the line box adds descender space below the glyph — the logo box
     grows ~4px taller than the logo and sits visibly above the header's
     vertical center. Flex anchors shrink-wrap the glyph exactly. */
  .nav-mobile-header > a,
  .nav-mobile-overlay__top > a {
    display: flex;
  }
  .nav-mobile-header__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-icon-default);
  }

  @media (min-width: 1024px) {
    .nav-mobile-header {
      display: none;
    }
  }

  /* --- Mobile overlay (Figma mock, signed off 2026-07-24) --- */
  .nav-mobile-overlay {
    display: none;
    flex-direction: column;
    position: fixed;
    inset: 0;
    z-index: 950;
    padding: 12px 20px 40px;
    background: var(--color-bg-default);
    /* Phone LANDSCAPE is still below 1024px, so it gets this overlay — and
       the content column (three 48px items + the CV + the social row + the
       theme row, at 32px gaps) runs to ~530px against a ~375px-high
       viewport. Unscrollable, the theme toggle sat off-screen with nothing
       that could reach it. `contain` stops a flick that hits the end here
       from chaining to the page behind. */
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    /* `pointer-events: none` hides the closed menu from the mouse but NOT
       from the keyboard or a screen reader: it stays `display: flex` below
       1024px, so Tab off the hamburger used to walk into eight invisible
       controls (and could flip the theme from a menu that isn't on screen).
       `visibility` removes it from both.

       The 0s-plus-delay pair is what keeps the fade-out intact: opening
       flips visibility immediately (no delay) so the fade-in is visible and
       `closeButton.focus()` has something focusable to land on, while
       closing holds `visible` for the full 250ms and only then hides. Not
       `visibility 0.25s` — a discrete property's flip point mid-transition
       is spec detail to lean on, and at progress 0 it is still the OLD
       value, which is exactly the frame the open handler focuses in. */
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }
  .nav-mobile-overlay[data-open] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0s;
  }

  @media (min-width: 1024px) {
    .nav-mobile-overlay {
      display: none !important;
    }
  }
  @media (max-width: 1023px) {
    .nav-mobile-overlay {
      display: flex;
    }
  }

  /* `flex-shrink: 0` on the two fixed rows: once the content column
     overflows a short landscape viewport, these are the first things
     flexbox compresses, and squashing the row that holds the close button
     is the worst possible answer. Pixel-neutral whenever there's room. */
  .nav-mobile-overlay__top {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .nav-mobile-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-icon-default);
  }

  .nav-mobile-overlay__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xl);
  }
  /* `flex: 1` is what pushes the social row to the bottom, against the
     divider, instead of letting it sit directly under the nav block with dead
     space below. Master 2240:2 models it the same way: `nav-items` FILLs the
     overlay and an inner frame FILLs again, so the four links centre in
     whatever height is left and the socials land last. */
  .nav-mobile-overlay__items {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 48px rows, from the same master — the nav-item instances there are FIXED
     at 48 rather than hugging their 34px of type. Worth taking for more than
     fidelity: 34px is under the ~44px minimum tap target, and these are the
     primary navigation on a phone. `min-height` rather than `height` so a
     wrapped label can still grow. :global() because the class lands on
     NavItem's own <a>, which carries that component's astro-cid, not this
     one's. */
  :global(.nav-mobile-overlay__items .nav-item) {
    min-height: 48px;
  }
  /* The overlay CV button runs at the nav items' 18px, not the header's 14px
     — instance override on 2932:461, which takes the button to 208x48. Sizing
     it like the links is what makes it read as the fourth item in the list
     rather than a control that wandered in. Mirrored as an override here
     because Figma models it as one too, not as a size variant of button-text.

     `a.button-text.…` at (0,2,1) is load-bearing, not verbosity: ButtonText's
     own rule compiles to `.button-text[data-astro-cid-…]` = (0,2,0), so a bare
     `:global(.nav-mobile-overlay__cv)` at (0,1,0) loses outright — measured,
     the label stayed 14px. Matching at (0,2,0) would only TIE, and a tie
     resolves on bundling order, which is the bug-002 non-determinism. One
     element selector settles it. Third time this file's family of components
     has needed exactly this. */
  :global(a.button-text.nav-mobile-overlay__cv) {
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
    /* BOLD, not the component's medium. The override on 2932:461 is the whole
       `Manrope/lg/bold-CAPITALIZED` style — byte-for-byte the one the nav
       items use — so the CV reads as the fourth link rather than a lighter
       guest among them. Size alone left the label 3.6px narrow (204.4 against
       the canvas's 208), which is what gave the missing weight away. */
    font-weight: var(--font-weight-bold);
  }
  .nav-mobile-overlay__links {
    display: flex;
    gap: var(--spacing-sm);
  }
  .nav-mobile-overlay__links a {
    color: var(--color-icon-default);
  }

  .nav-mobile-overlay__footer {
    display: flex;
    flex-shrink: 0;
    justify-content: center;
    padding-top: var(--spacing-lg);
    margin-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border-default);
  }
</style>
