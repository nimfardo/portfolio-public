---
// Heading + a big statement line + tag pills, no image — Figma split this
// out of the old hero card once tags moved off the hero image (see
// widgets/project-hero). Same 33/66 reference-column grid as ContentSection.
//
// feat-033 additions, all optional so CONNECTIS renders unchanged: a
// smaller description paragraph under the statement, a row of clickable
// sub-brand LinkCards (defenceSystems's subBrandOne.example / subBrandTwo.example pair), and
// tags may be omitted — defenceSystems's Challenge reuses this widget as a bare
// statement + description section.
// The card markup itself now lives in entities/project's LinkCards — medicalSoftware
// needed the same cards inside a ContentSection, so keeping them here would
// have meant two copies of the pinned-colour rules (bug-040).
import { Heading } from '@shared/ui';
import { Media } from '@entities/media';
import { LinkCards } from '@entities/project';
import type { LinkCard, FeatureList, ProjectMedia } from '@entities/project';

interface Props {
  heading: string;
  /** A media slot above the statement — Logofolio's construction diagram
   * for its "Mdt" mark, the first Overview to carry one. Every other page
   * omits it and renders unchanged. */
  image?: ProjectMedia;
  tags?: string[];
  /** About's skills list (copy-037) — a plain bulleted list at the same size
   * as the statement above it, no label. Unlike `features`, which is a
   * smaller/labeled block for a *different* statement (enterpriseIt's), this one
   * continues the Lead paragraph's own type ramp. */
  list?: string[];
  description?: string;
  /** enterpriseIt's "Features:" block — a bold label over a bulleted list. */
  features?: FeatureList;
  linkCards?: LinkCard[];
  class?: string;
}

const { heading, image, tags, list, description, features, linkCards, class: className } = Astro.props;
---

<section class:list={['section-grid', 'overview-section', className]}>
  <Heading class="section-grid__aside overview-section__heading">{heading}</Heading>
  <div class="section-grid__body overview-section__body" data-reveal>
    {
      image &&
        (image.type === 'image' ? (
          <img
            class="overview-section__image"
            src={image.image}
            alt={image.imageAlt}
            loading="lazy"
            data-media-skeleton
          />
        ) : (
          <Media type="video" class="overview-section__image" src={image.src} poster={image.poster} alt={image.alt} />
        ))
    }
    <p class="section-prose overview-section__text"><slot /></p>
    {
      list && (
        <ul class="overview-section__list">
          {list.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    {description && <p class="overview-section__description">{description}</p>}
    {
      features && (
        <div class="overview-section__features">
          <p class="overview-section__features-label">{features.label}</p>
          <ul class="overview-section__features-list">
            {features.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    }
    {linkCards && <LinkCards cards={linkCards} />}
    {
      tags && (
        <ul class="overview-section__tags">
          {tags.map((tag) => (
            <li class="overview-section__tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  /* Grid, column spans and the 1023px collapse come from .section-grid in
     global.css; the statement's type ramp comes from .section-prose there
     too — deliberately without `white-space: pre-line`, which this one
     statement (unlike the other four) has never had (ref-005). */
  .overview-section__body {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  /* :global() — the video branch's class merges onto Media's own rendered
     root <div> (that component's own astro-cid, not this one's); still
     matches the plain <img> in the image branch, so one rule covers both.
     1071x630 is Logofolio's own frame size, not a shared ratio — this slot
     has one consumer so far. */
  :global(.overview-section__image) {
    width: 100%;
    aspect-ratio: 1071 / 630;
    object-fit: cover;
  }
  /* About's skills list (Figma node 3183:2633, copy-037) — Manrope/xl/
     regular-loose, the same ramp .overview-section__description below uses,
     not the 4xl/medium statement above it (checked directly against the
     node's own text style, not assumed from its neighbor). 16px item gap
     matches Figma's own listSpacing; bullets hang outside the text column
     like .overview-section__features-list below. */
  .overview-section__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin: 0;
    padding-left: 1.5em;
    list-style: disc;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-3xl);
    letter-spacing: -0.2px;
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
  }
  /* Figma text style Manrope/xl/regular-loose (node 2487:2264) — the
     smaller paragraph defenceSystems runs under its statement lines. */
  .overview-section__description {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-3xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
    white-space: pre-line;
  }
  /* enterpriseIt's Features block (Figma 2928:2365). The label is Manrope/xl/bold
     (2928:2340); the items reuse the description's Manrope/xl/regular-loose
     ramp (2928:2348 carries the same style), so the two stay in step if that
     ramp moves. 16px label-to-list is Figma's own gap: the list text sits at
     y=44 under a 28px label. */
  .overview-section__features {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .overview-section__features-label {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-emphasis);
  }
  .overview-section__features-list {
    margin: 0;
    /* Bullets hang outside the text column so the items align with the
       statement above them, matching the canvas. */
    padding-left: 1.5em;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-3xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
  }
  .overview-section__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .overview-section__tag {
    padding: 8px 14px;
    border: 1px solid var(--color-border-emphasis);
    border-radius: var(--radius-full);
    font-family: var(--font-family-body);
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-emphasis);
    /* No `white-space: nowrap`, and no breakpoint re-enabling it (bug-079).
       A pill wraps exactly when it does not fit and never otherwise, which
       is what intrinsic sizing already does: these are flex items with the
       default `min-width: auto`, so each one is laid out at its max-content
       width while there is room and shrinks toward min-content when there
       is not. Every pill that fits renders identically to the nowrap
       version — measured across 11 pages x 14 widths, not assumed.

       The rule this replaces was `nowrap` plus `white-space: normal` under
       767px, which read as "wrap on phones" and was wrong in a way a
       viewport breakpoint structurally cannot fix: the constraint is the
       CONTAINER, not the screen. `.section-grid`'s 33/66 split is still
       active from 1024px up, so the body column there is ~600px — NARROWER
       than the full-width ~688px it gets at 768px. enterpriseIt's 598px scope tag
       and Khvyliasti's 584px one therefore overflowed the page at 1024px
       (57px and 44px) while being perfectly fine on a phone, and no
       `max-width` breakpoint can express "the container got smaller as the
       window got bigger". Third time this band has produced a bug — see
       bug-053 and the Outcomes grid in feat-157. */
  }
</style>
