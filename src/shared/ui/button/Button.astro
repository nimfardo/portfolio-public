---
import Icon from '../icon/Icon.astro';
import type { IconName } from '../icon/Icon.astro';

interface Props {
  type?: 'solid' | 'outlined';
  /* Figma set 2006:327 gained a `size` property in feat-100. `md` is the
     320x60 button the whole site already used; `sm` is the 40-tall header CV
     button — 12px label, a 20px glyph instead of 28, and no min-width,
     because it sits in a 48px header row rather than on a page. Same
     border/ink tokens and the same hover and disabled contracts, which is why
     this is a variant and not a component. */
  size?: 'md' | 'sm';
  disabled?: boolean;
  href?: string;
  /* Force the new-tab treatment. The default heuristic below only catches
     absolute URLs, and the CV is a same-origin FILE (`/max-shturma-cv.pdf`) —
     it has to open in a new tab because the ClientRouter cannot swap a PDF
     into the SPA, but it would fail a `startsWith('http')` test. Explicit
     beats widening the heuristic, which would start guessing about every
     internal path with a dot in it. */
  external?: boolean;
  class?: string;
  /* The trailing glyph. Defaults to the arrow every button shipped with, so
     existing call sites are untouched. /about's Contact button (canvas
     2901:1911) is the first to override it — Max swapped that instance's glyph
     to an envelope while the LAYER is still named `right-arrow`, which is the
     Button master's slot name. The name is not the glyph: the exported path
     there is byte-identical to this project's `mail.svg`. */
  icon?: IconName;
}

const {
  type = 'solid',
  size = 'md',
  disabled = false,
  href,
  external,
  class: className,
  icon = 'arrow-right',
} = Astro.props;
const Tag = href ? 'a' : 'button';
// External destinations (Behance, GitHub, ...) open in a new tab; internal
// routes stay in-tab so ClientRouter transitions keep working (bug-038).
// An explicit `external` wins over the heuristic — see the prop's note.
const isExternal = external ?? href?.startsWith('http');
// sm draws its glyph at 20, md at 28 (Figma set 2006:327).
const iconSize = size === 'sm' ? 20 : 28;
---

<Tag
  class:list={['button', `button--${type}`, `button--${size}`, className]}
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  <span class="button__label"><slot /></span>
  <Icon name={icon} size={iconSize} class="button__icon" />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-family-body);
    font-weight: var(--font-weight-medium);
    /* 0.04em, not a px value, so it tracks the size variant on its own:
       0.72px at md's 18px, 0.48px at sm's 12px. Figma carries the same 4%
       on both text styles, so the two stay in step without a second rule. */
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  /* --- size: md (the 320x60 button every page already used) --- */
  .button--md {
    gap: var(--spacing-sm);
    /* Canvas 2901:1911 carries min-width 240, not 320, and that difference is
       deliberately NOT taken. It cannot bind on the button that surfaced it —
       /about's Contact button is content-driven at 366px — but lowering it
       would shrink PasswordGate's short "Enter" label from 320 to 240 on
       another page. A library value that moves shipped pixels elsewhere is not
       worth the tidiness. */
    /* `min(320px, 100%)`, not a bare 320px: min-width is resolved AFTER
       max-width in the box algorithm, so a flat floor here wins over any
       `max-width: 100%` a caller adds and the button simply hangs out of the
       page. On a 320px-wide phone the content column is 272px, so five pages
       panned sideways by 24px. This clamps to the container only where the
       container is narrower than the floor, so every md button on every
       route measured pixel-identical at 390/480/768/1024/1440 — the sole
       exception being /system's gallery cells, whose 310px column the
       buttons were overhanging rather than fitting. */
    min-width: min(320px, 100%);
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-lg);
  }

  /* --- size: sm (the header CV button) --- */
  .button--sm {
    gap: 12px;
    /* No min-width on purpose. md's 320 floor exists so page-level CTAs share
       a width; this one is ~161px of content inside a 48px header row, where a
       floor would only push the theme-toggle around. */

    /* Resized down from the first cut (187x48) on Max's review: canvas-exact
       is not the same as right-sized. The design is drawn on a 1920 frame
       whose header column is 1647 wide; at a 1440 window the site's header is
       1287, so a fixed 187px button went from 11.4% of the row on canvas to
       14.6% on screen — about a quarter heavier — while measuring as a
       pixel-perfect match. Figma set 2006:327 and the header master were
       moved to these same values in the same pass, so design and code did not
       drift apart.

       Every value here is the Figma number MINUS the 1px border, which is not
       fussiness: Figma strokes this frame on the INSIDE (checked via
       `strokeAlign`), so its 40px box already contains the border, while CSS
       paints the border outside the padding box. Taken literally, 10/20/17
       renders a 42px control in a 40px row — the same trap the 48px cut hit.

       The 20-left / 17-right asymmetry is optical and must survive: the
       download glyph's ink stops ~2.9px inside its 20px box (its 28-viewBox
       art spans x 4..24), so 17 + 2.9 reads as ~20 against the 20 on the text
       side. Equalising them would look right-heavy. */
    padding: 9px 16px 9px 19px;
    font-size: var(--font-size-xs);
    line-height: var(--font-line-height-xs);
  }

  .button--solid {
    background: var(--color-bg-accent);
    color: var(--color-text-on-accent);
  }
  .button--solid:hover:not(:disabled):not([aria-disabled='true']) {
    background: var(--color-bg-accent-hover);
  }
  .button--solid:disabled,
  .button--solid[aria-disabled='true'] {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .button--outlined {
    border: 1px solid var(--color-border-accent);
    color: var(--color-text-accent);
  }
  .button--outlined:hover:not(:disabled):not([aria-disabled='true']) {
    border-color: var(--color-border-emphasis);
    color: var(--color-text-emphasis);
  }
  .button--outlined:disabled,
  .button--outlined[aria-disabled='true'] {
    border-color: var(--color-border-default);
    color: var(--color-text-muted);
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
