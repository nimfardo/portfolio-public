---
import type { Stat } from '../model/types';

interface Props extends Stat {
  class?: string;
}

const { value, unit, label, class: className } = Astro.props;
---

<div class:list={['stat', className]}>
  <p class="stat__value">
    <span class="stat__number" data-count-up style={`min-width: ${value.length}ch`}>{value}</span>{
      unit && (
        <>
          {' '}
          <span class="stat__unit">{unit}</span>
        </>
      )
    }
  </p>
  <p class="stat__label">{label}</p>
</div>

<style>
  .stat {
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    /* Figma's real text style: text-primary, mixed case, no tracking —
       the old 5xl/bold/uppercase/text-emphasis treatment didn't match.
       Inherited by .stat__value and .stat__unit; .stat__label overrides it
       below (copy-047) and no longer takes this. */
    color: var(--color-text-primary);
  }
  .stat__value {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-8xl);
    line-height: var(--font-line-height-8xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: -1.92px;
  }
  /* The number rolls 0 -> value on first view (feat-086), so its box has to
     be final-size from frame one or the unit beside it would shuffle right
     for 900ms. `tabular-nums` makes every digit exactly 1ch wide, which is
     what lets the `min-width` above be exact rather than approximate.
     inline-block is only there so min-width applies at all. */
  .stat__number {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
  .stat__unit {
    font-size: 32px;
    line-height: 48px;
    letter-spacing: -0.32px;
  }
  /* --color-text-emphasis, not the --color-text-primary the rest of the
     component inherits (copy-047). Max called the amber labels sitting under
     the figures "colored small texts" in review and asked for emphasis
     across the board.

     The obvious objection is that emphasis is BRIGHTER than primary
     (#faeee1 vs #efcba6 on dark), so this makes the small text lighter than
     the big figure above it. It does, and it still reads correctly: at 20px
     against a 96px numeral the size difference carries the hierarchy on its
     own, and a ~4:1 area ratio is not something a few points of luminance
     can invert. That objection DID hold for the 14px method line this
     replaced (see OutcomesSection), which is why that one was cut instead
     of recoloured — three tiers is where the palette ran out, not two.

     Set here rather than in OutcomesSection so BuildSection's stat row on
     the same CONNECTIS page matches it; scoping it to one consumer is how
     the component would have ended up rendering two different ways on one
     page. Measured 17.20:1 dark and 16.79:1 light, up from 12.88/13.90. */
  .stat__label {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-xl);
    line-height: var(--font-line-height-xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-emphasis);
  }
</style>
