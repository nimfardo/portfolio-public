---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/manrope';
import '@shared/config/tokens.css';
import '@app/styles/global.css';
import { Preloader } from '@widgets/preloader';
import { Navigation } from '@widgets/navigation';
import { ScrollToTop } from '@features/scroll-to-top';

interface Props {
  title: string;
  /** Figma's 404 frame (node 2326:1301) has no nav/header, unlike every
   * other page including the Password and No-Content states — the one
   * current use case. */
  hideNav?: boolean;
  /** Keeps a route out of search results. Set for NDA project pages
   * (bug-073) — bug-073 stopped the case studies being *readable* to a
   * crawler, but the five URLs were already indexed, so they also need to
   * be told to leave. Everything else stays indexable on purpose. */
  noindex?: boolean;
}

const { title, hideNav = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5FMLZKD7C7"
    ></script>
    <script is:inline>
      // send_page_view is off here because ClientRouter swaps pages without a
      // full reload, so gtag's automatic page_view (fired once, on this
      // config call) would only ever count the very first page of a session.
      // astro:page-load fires once for that initial load and again after
      // every swap, so hooking page_view there counts every page uniformly.
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-5FMLZKD7C7', { send_page_view: false });
      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', {
          page_location: location.href,
          page_title: document.title,
        });
      });
    </script>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" id="favicon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // The favicon is a bare mark with no tile, so it has to invert against
      // the browser's tab strip: amber (#efcba6) on a dark strip, obsidian
      // (#110a03) on a light one — matching the Figma tab spec at 2826:11.
      //
      // This is driven from here rather than by a `prefers-color-scheme`
      // media query inside the SVG, because Chrome resolves that query to
      // `light` when it renders an SVG through the image path regardless of
      // the actual browser theme (measured, not assumed), which would put the
      // obsidian mark on a dark strip. `matchMedia` in page context does
      // report the real scheme, so the page picks the file instead.
      //
      // NOTE: this tracks the BROWSER/OS theme, which is what colours the tab
      // strip — deliberately not the site's own `theme` localStorage toggle.
      (function () {
        const q = matchMedia('(prefers-color-scheme: light)');
        function apply() {
          const el = document.getElementById('favicon');
          if (el) el.href = q.matches ? '/favicon-light.svg' : '/favicon.svg';
        }
        apply();
        q.addEventListener('change', apply);
        // ClientRouter swaps the head; re-apply against the new <link>.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    {
      /* Static, not a prefers-color-scheme pair: the light theme is a
       * localStorage preference (see the inline script below), not an OS
       * one, so a media-query pair would disagree with the rendered page
       * whenever the two differ. Dark is the default theme. */
    }
    <meta name="theme-color" content="#110a03" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {
      /* Site-wide, not per-page — one og-image.jpg (1200x630, Figma-designed)
       * covers every route. Social crawlers read these tags straight from the
       * static HTML with no JS, so this can't track the CV's `?for=` role
       * param the way the header CV link does; Max's call was to ship one
       * image site-wide rather than build per-role static routes for it. */
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Max Shturma" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Product Designer with nine years of UX/UI depth. I design products end to end — research, flows, design systems — and build them in code."
    />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="Product Designer with nine years of UX/UI depth. I design products end to end — research, flows, design systems — and build them in code."
    />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      // Dark is the default (dark-first design); light is opt-in and persisted.
      function applyStoredTheme() {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        } else {
          delete document.documentElement.dataset.theme;
        }
      }
      applyStoredTheme();
      // ClientRouter swaps replace <html>'s attributes with the freshly
      // fetched page's (server-rendered markup never carries data-theme —
      // it's a client-only runtime preference), which silently resets the
      // theme to dark on every internal navigation. Re-apply right after
      // the swap, before the new page paints.
      document.addEventListener('astro:after-swap', applyStoredTheme);
    </script>
    <ClientRouter />
  </head>
  <body>
    <Preloader />
    {!hideNav && <Navigation />}
    {!hideNav && <ScrollToTop />}
    <div class:list={['page-content', { 'page-content--no-nav': hideNav }]}>
      <slot />
    </div>
    <script>
      import {
        initScrollReveal,
        initCountUp,
        initCvRole,
        initMediaSkeleton,
        initScrollState,
      } from '@shared/lib';
      // `astro:page-load` fires once for the real initial load and again
      // after every ClientRouter swap — top-level module scripts only ever
      // run once, so anything that needs to see the *new* page's content
      // (new [data-reveal] elements) has to hang off this event instead.
      document.addEventListener('astro:page-load', initScrollReveal);
      document.addEventListener('astro:page-load', initCountUp);
      // ⚠ Called DIRECTLY here, not only on the event, and that is the whole
      // difference between this working and doing nothing at all.
      // `astro:page-load` fires at `window.load` — measured at 10.6s into a
      // throttled /projects/logofolio, by which point every eager image had
      // already decoded. Registering only the listener meant the skeleton
      // could never appear on a first page load, which is the one case it
      // exists for. This top-level call runs when the deferred module
      // executes (~2.4s in that same trace, right after parse, images in the
      // DOM and still in flight); the listener below then covers ClientRouter
      // swaps, where the module never re-runs.
      initMediaSkeleton();
      document.addEventListener('astro:page-load', initMediaSkeleton);
      // An NDA project page has no [data-reveal] or counter elements at
      // page-load — they arrive as decrypted markup when the password gate
      // opens (bug-073). PasswordGate fires `nda:unlocked` once injected.
      document.addEventListener('nda:unlocked', initScrollReveal);
      document.addEventListener('nda:unlocked', initCountUp);
      // Load-bearing for the same reason: a gated page's images don't exist
      // at page-load, so without this line every NDA project's media skips
      // the skeleton entirely.
      document.addEventListener('nda:unlocked', initMediaSkeleton);
      // Also re-derives the CV button's href each swap, so a role picked up
      // from a `?for=` param on one page keeps applying on every other page
      // even though its own URL carries no such param.
      document.addEventListener('astro:page-load', initCvRole);
      document.addEventListener('astro:page-load', initScrollState);
    </script>
  </body>
</html>

<style>
  /* Reserves space for the persistent nav chrome from widgets/navigation:
     a 153px desktop sidebar, or a 64px mobile header below 1024px. */
  .page-content {
    padding-top: 64px;
  }
  @media (min-width: 1024px) {
    .page-content {
      padding-top: 0;
      padding-left: 153px;
    }
  }
  .page-content--no-nav {
    padding: 0;
  }
</style>
