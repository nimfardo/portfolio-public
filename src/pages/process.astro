---
// The nav has linked to /process since copy-003, but the route never existed —
// this page closes that 404. (/about is still outstanding.)
//
// Structure follows Max's Figma frame (node 2124:1834): a lead statement in
// the 66% column, the 16-step accordion, then the Build section. BuildSection
// is reused verbatim from the case-study pages — it already renders a
// hardcoded "Build" heading, one media+text block and an optional GitHub
// button, which is exactly what the canvas has.
//
// The 16 steps were a pinned horizontal-scroll rail (ProcessRail) through
// feat-092; feat-1XX retired it for the site's standard vertical scroll —
// Max's call, site-wide — as a vertical accordion (WorkflowAccordion),
// designed in Figma first as a content variant of the case-study Accordion
// component before this port.
import Layout from '@app/layouts/Layout.astro';
import { Heading } from '@shared/ui';
import { PageHeader } from '@widgets/page-header';
import { ProjectHero } from '@widgets/project-hero';
import { WorkflowAccordion } from '@widgets/workflow-accordion';
import { BuildSection } from '@widgets/build-section';
import type { ContentBlock } from '@entities/project';

// The shared Glacier Flow block, byte-identical to the one defenceSystems, CONNECTIS and
// medicalSoftware carry — one video file in public/media/shared/, one caption. feat-046
// had built this page its own still instead, which also meant it shipped the
// *stale* pre-copy-008 caption while every case study carried the approved
// short one. Reusing the block resolves both (feat-050).
//
// `/media/process/build.jpg` is unreferenced as of this change and awaiting
// Max's call on deleting it.
const buildBlocks: ContentBlock[] = [
  {
    media: {
      type: 'video',
      src: '/media/shared/glacier-flow.webm',
      poster: '/media/shared/glacier-flow-poster.jpg',
      alt: "Glacier Flow's title card, then a scroll through the template's public GitHub README — core idea, folder map, and the gated task workflow",
    },
    text: 'I use Glacier Flow, a Claude Code template: folder routing, a knowledge base, and gated tasks.',
  },
];
---

<Layout title="Design Process — Max Shturma">
  <main class="process">
    {
      /* PageHeader's title is a <span>, and it's display:none below 1024px —
        so without this the page has no h1 at any width. */
    }
    <h1 class="visually-hidden">Design Process</h1>

    <PageHeader title="Design Process" class="process__header" />

    {
      /* Max added this hero to the canvas on 2026-08-16 (node 2712:2272) —
        the same bare media + "Scroll down" shape every case-study page
        opens with, so it's ProjectHero verbatim.

        Filled on 2026-08-24 with a static desk photo, then swapped for real
        footage on 2026-09-01: Max shot himself at his own desk mid-workflow
        (uploads/process-hero.webm, 1646x800, 5s) — Figma open on the main
        monitor, a Claude Code session running on the laptop and the second
        monitor. It's a fitting hero for this specific page, not just any
        desk shot: the 16-step workflow below is literally Figma-to-Claude
        Code. webm kept as uploaded, `.mp4` transcoded the standard way
        (libx264, CRF23, audio stripped), poster pulled at t=0.3s (no
        fade-in on this clip, so frame 0 itself was usable, just nudged past
        the very first frame). The old static hero.jpg is gone — nothing
        else referenced it.

        `2712:2273` is easy to mistake for /about's hero — both pages use a
        `project-hero-image` instance at 1647x800, so the node's dimensions
        don't distinguish them. The parent frame does: 2712:2272 is this page,
        2793:3169 is /about. Figma itself still shows the old static image on
        this node — this swap is code-only for now. */
    }
    <ProjectHero
      media={{
        type: 'video',
        src: '/media/process/hero.webm',
        poster: '/media/process/hero-poster.jpg',
        alt: 'Max at his desk from behind — Figma open on the main monitor mid-edit, a Claude Code session running on the laptop and second monitor',
      }}
      scrollCue
    />

    <div class="process__lead section-grid">
      {
        /* Labels the lead + rail as one section, the way "Build" labels the
          block below it. "Workflow" rather than "Process" — the page title
          is already "Design Process", and this names what the 16 steps
          actually are. */
      }
      <Heading class="section-grid__aside">Workflow</Heading>
      {
        /* Verbatim from canvas node 2669:10778, re-trimmed 2026-09-01 — Max
          cut the closing "That keeps client expectations..." sentence on
          canvas, so the port drops it too rather than keeping a line canvas
          no longer carries.

          It also drops the old "nothing is ever exported" claim, and that is
          the point rather than an omission: the workflow now runs through
          Figma screens, code, deploy and testing (steps 10-16), so the claim
          had stopped being true. */
      }
      <p class="process__lead-text section-grid__body">
        I take every new project from scratch through the same 16 steps. Context is stored locally
        and updated after every decision.
      </p>
    </div>

    {
      /* Canvas right-aligns the accordion frame (1071px) inside the same
        1647px row the lead paragraph's own body column sits in (items-end
        on their shared parent) — so its left edge lands exactly on the
        paragraph's left edge, not the page's own left padding. WorkflowAccordion
        itself carries no width/offset opinion; section-grid__body (the same
        33/66 column the paragraph above already uses) does the alignment,
        with column 1 left empty rather than repeating the "Workflow" label. */
    }
    <div class="process__accordion-row section-grid">
      <div class="section-grid__body">
        <WorkflowAccordion />
      </div>
    </div>

    <div class="process__build">
      <BuildSection blocks={buildBlocks} githubUrl="https://github.com/nimfardo/glacier-flow" />
    </div>
  </main>
</Layout>

<style>
  /* :global() — the class merges onto PageHeader's own rendered element, which
     carries PageHeader.astro's astro-cid, not this page's. */
  /* The 40px side gutter that used to live here moved into PageHeader
     itself (feat-159) — it has to own its own box for the sticky backdrop to
     span the content width. */

  .process {
    padding-bottom: 160px;
  }

  /* Reuses the shared 33/66 reference grid (ref-005): the "Workflow" label
     in the left track, the statement in the body column starting at x=769
     (193 + 576) exactly as on canvas. The grid carries the columns and the
     <=1023px stack on its own, so there is nothing to add here. */
  .process__lead {
    padding: 0 40px;
    /* 160px below the hero, measured off the canvas (Hero-section ends at
       y=1028, lead starts at y=1188) — the same section rhythm the
       case-study pages use between the hero and everything under it. Was
       96px when the lead sat directly under the header. */
    margin-top: 160px;
  }
  .process__lead-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-4xl);
    line-height: var(--font-line-height-5xl);
    letter-spacing: -0.4px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-emphasis);
  }

  /* Same 40px page-edge padding every other section here carries — the
     accordion previously had none at all, sitting flush at x=0. */
  .process__accordion-row {
    padding: 0 40px;
  }

  /* Back to the site's standard 160px section gap. feat-048 had cut this to
     96px to compensate for the pinned rail's own slack; feat-051 removed that
     slack at the source (the viewport is sized to its content now), so this
     margin is once again the only thing between the rail and Build. */
  .process__build {
    padding: 0 40px;
    margin-top: 160px;
  }

  @media (max-width: 1023px) {
    /* Same scale-down [slug].astro applies to its own 160px rhythm — that
       much empty space between sections is desktop-only. */
    .process__lead,
    .process__build {
      margin-top: var(--spacing-4xl);
    }
  }

  @media (max-width: 767px) {
    :global(.process__header) {
      padding: 0 24px;
    }
    .process__lead,
    .process__accordion-row,
    .process__build {
      padding: 0 24px;
    }
    .process {
      padding-bottom: var(--spacing-4xl);
    }
  }
</style>
